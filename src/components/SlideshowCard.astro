---
// The bottom two cards of visual tour and my collection which contain a slideshow of the items in the collection. The slideshow auto-advances every 7 seconds, and can be manually advanced with the left/right buttons. The slideshow is also linked to the card's href, so clicking on the card will take you to the first item in the slideshow.

interface Item { title: string; meta: string; href: string; }
interface Props { items: Item[]; group: string; }
const { items, group } = Astro.props;
const first = items[0] || { title: 'No items', meta: 'EMPTY', href: '#' };
---
<div
  class="cc-card is-selected cc-slideshow"
  data-slideshow-group={group}
  data-href={first.href}
  data-group={group}
  data-title={first.title}
  data-meta={first.meta}
  data-image=""
  data-items={JSON.stringify(items)}
  data-index="0"
  tabindex="0"
  role="button"
>
  <div class="cc-slideshow__index" id="cc-slideshow-index-{group}">01</div>
  <div class="cc-slideshow__body">
    <div class="cc-slideshow__title">{first.title}</div>
    <div class="cc-slideshow__meta">{first.meta}</div>
  </div>
  <div class="cc-slideshow__dots">
    {items.map((_, i) => <span class={i === 0 ? 'is-active' : ''}></span>)}
  </div>
  <span class="cc-card__corner-br"></span>
</div>
<style>
  .cc-slideshow {
  position: relative;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  height: 100%;
  min-height: 0;
  padding: 20px 22px;
  background: var(--blue-card);
  overflow: hidden;
}
  .cc-slideshow.is-selected { background: var(--blue-card); }
  .cc-slideshow:hover.is-selected { background: var(--blue-card-hover); }

  .cc-slideshow__index {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 2rem;
  color: var(--blue-panel-light);
  opacity: 0.35;
  line-height: 1;
  margin-bottom: 6px;
}

.cc-slideshow__title {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 1.3rem;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--blue-lightest);
  margin-bottom: 4px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cc-slideshow__meta {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--yellow);
  opacity: 0.9;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

  .cc-slideshow__dots {
    position: absolute; bottom: 12px; right: 14px;
    display: flex; gap: 5px; z-index: 4;
  }
  .cc-slideshow__dots span {
    width: 5px; height: 5px; border-radius: 50%;
    background: rgba(166,232,255,0.4);
  }
  .cc-slideshow__dots span.is-active { background: var(--yellow); }
</style>
<script>
  // @ts-nocheck
import { gsap } from 'gsap';

  document.querySelectorAll<HTMLElement>('.cc-slideshow').forEach((card) => {
    const group = card.dataset.slideshowGroup!;
    const items = JSON.parse(card.dataset.items || '[]') as
      { title: string; meta: string; href: string }[];
    if (items.length <= 1) return;

    let index = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    const indexEl = card.querySelector('.cc-slideshow__index') as HTMLElement;
    const titleEl = card.querySelector('.cc-slideshow__title') as HTMLElement;
    const metaEl = card.querySelector('.cc-slideshow__meta') as HTMLElement;
    const dots = card.querySelectorAll('.cc-slideshow__dots span');

    function goTo(i: number) {
      index = ((i % items.length) + items.length) % items.length;
      const item = items[index];
      // slower, calmer crossfade — was 0.25s/0.35s, now a full second
      // each way so it reads as a deliberate slide change, not a flicker
      const tl = gsap.timeline();
      tl.to([indexEl, titleEl, metaEl], { opacity: 0, y: -6, duration: 0.5, ease: 'power1.in' })
        .call(() => {
          indexEl.textContent = String(index + 1).padStart(2, '0');
          titleEl.textContent = item.title;
          metaEl.textContent = item.meta;
          card.dataset.title = item.title;
          card.dataset.meta = item.meta;
          card.dataset.href = item.href;
        })
        .fromTo([indexEl, titleEl, metaEl],
          { opacity: 0, y: 6 },
          { opacity: 1, y: 0, duration: 0.6, ease: 'power1.out' }
        );
      dots.forEach((d, di) => d.classList.toggle('is-active', di === index));
    }

    function start() {
      // was 4000ms — slowed to 7000ms so it doesn't feel rushed
      timer = setInterval(() => goTo(index + 1), 7000);
    }
    function stop() {
      if (timer) clearInterval(timer);
    }

    start();
    card.addEventListener('mouseenter', stop);
    card.addEventListener('mouseleave', start);

    document.querySelectorAll(`[data-select-group="${group}"]`).forEach((btn) => {
      btn.addEventListener('click', () => {
        stop();
        const dir = Number(btn.dataset.dir ?? '1');
        goTo(index + dir);
        start();
      });
    });
  });
</script>