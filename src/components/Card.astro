---
// src/components/Card.astro
//
// <Card href="..." title="..." meta="..." imageSrc="..." group="films" variant="poster" />
//
// variant:
//   "default" — landscape thumbnail + text (tour, collections)
//   "poster"  — portrait movie-poster shaped thumbnail (film recommendations)
//   "text"    — no image, full-width text bar (blog channel-list rows)
//
// Single click selects. Same `group` on every card in a list makes
// selection exclusive within that list. Double-click navigates to
// `href`. Up/down + Enter in the parent Panel drive the same state.

interface Props {
  href: string;
  title: string;
  meta?: string;
  imageSrc?: string;
  imageAlt?: string;
  group?: string;
  variant?: 'default' | 'poster' | 'text';
}

const { href, title, meta, imageSrc = '', imageAlt = '', group, variant = 'default' } = Astro.props;
---
<div
  class={`cc-card cc-card--${variant}`}
  data-href={href}
  data-group={group ?? ''}
  data-title={title}
  data-meta={meta ?? ''}
  data-image={imageSrc}
  tabindex="0"
  role="button"
  aria-label={`${title}. Click to select, double-click to open.`}
>
  {variant !== 'text' && (
    <div class="cc-card__img">
      <img src={imageSrc} alt={imageAlt} loading="lazy" />
    </div>
  )}
  <div class="cc-card__body">
    <div class="cc-card__title">{title}</div>
    {meta && <div class="cc-card__meta">{meta}</div>}
  </div>
  <span class="cc-card__corner-br" aria-hidden="true"></span>
</div>

<style>
  .cc-card{
    position:relative;
    display:flex;
    gap:12px;
    align-items:flex-start;
    background:var(--blue-card);
    padding:12px;
    cursor:pointer;
    overflow:hidden;
    outline:none;
    width:100%;
    /* double-line bezel: a dark outer line, a lighter inset line one
       pixel in, plus a highlight/shadow bevel — reads as a hardware
       panel edge rather than a flat CSS border */
    border:1px solid var(--navy-deep);
    box-shadow:
      inset 0 0 0 1px var(--blue-panel-light),
      inset 1px 1px 0 rgba(255,255,255,0.2),
      inset -1px -1px 0 rgba(0,10,40,0.35);
  }

  /* corner brackets — a viewfinder/monitor-framing accent on two
     opposite corners, static, on-theme */
  .cc-card::before{
    content:"";
    position:absolute;
    top:3px; left:3px;
    width:8px; height:8px;
    border-top:2px solid var(--blue-panel-light);
    border-left:2px solid var(--blue-panel-light);
    opacity:0.8;
    pointer-events:none;
    z-index:1;
  }

  .cc-card__corner-br{
    position:absolute;
    bottom:3px; right:3px;
    width:8px; height:8px;
    border-bottom:2px solid var(--blue-panel-light);
    border-right:2px solid var(--blue-panel-light);
    opacity:0.8;
    pointer-events:none;
    z-index:1;
  }

  .cc-card:focus-visible{
    box-shadow:
      inset 1px 1px 0 rgba(255,255,255,0.25),
      inset -1px -1px 0 rgba(0,10,40,0.35),
      0 0 0 2px var(--yellow);
  }

  .cc-card__img{
    flex:0 0 clamp(56px, 8vw, 96px);
    aspect-ratio:4 / 3;
    background:var(--blue-panel-light);
    overflow:hidden;
    box-shadow:inset 0 0 0 1px rgba(0,10,40,0.3);
  }

  .cc-card__img img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  /* poster: portrait movie-poster proportions — sized from the row's
     available HEIGHT (fixed by flex ratios in index.astro), not from
     grid column width, so it stays a consistent size regardless of
     how much content is around it */
  .cc-card--poster{
    flex-direction:column;
    align-items:stretch;
    height:100%;
    width:auto;
    justify-self:start;
  }

  .cc-card--poster .cc-card__img{
    flex:1;
    min-height:0;
    width:auto;
    height:100%;
    aspect-ratio:2 / 3;
  }

  /* text: no image at all — a flat channel-list row */
  .cc-card--text{
    padding:10px 14px;
  }

  .cc-card__body{ min-width:0; }

  .cc-card__title{
    font-family:var(--font-ui);
    font-weight:600;
    font-size:clamp(11px, 0.85vw, 13px);
    text-transform:uppercase;
    letter-spacing:0.5px;
    color:var(--blue-lightest);
    margin-bottom:4px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }

  .cc-card--text .cc-card__title{
    margin-bottom:0;
    font-size:clamp(12px, 0.95vw, 14px);
  }

  .cc-card__meta{
    font-family:var(--font-body);
    font-size:clamp(11px, 0.85vw, 13px);
    color:var(--blue-lightest);
    opacity:0.7;
  }

  /* ---------- hover: glitch ---------- */
  .cc-card:hover{
    background:var(--blue-card-hover);
    animation:cc-glitch 0.4s steps(4) 1, cc-white-flash 0.4s ease-out 1;
  }

  .cc-card:hover .cc-card__title,
  .cc-card:hover .cc-card__meta{
    animation:cc-rgb-split 0.4s steps(4) 1;
  }

  .cc-card:hover::before{
    content:"";
    position:absolute;
    inset:0;
    background:repeating-linear-gradient(
      0deg,
      rgba(255,255,255,0.1) 0px,
      transparent 2px,
      transparent 4px
    );
    animation:cc-static-noise 0.1s steps(2) infinite;
    pointer-events:none;
    z-index:2;
  }

  .cc-card:hover::after{
    content:"";
    position:absolute;
    inset:0;
    border:2px solid var(--yellow);
    opacity:0;
    animation:cc-edge-flash 0.4s steps(4) 1;
    pointer-events:none;
    z-index:3;
  }

  @keyframes cc-glitch{
    0%{ transform:translate(0,0); filter:none; }
    15%{ transform:translate(-2px,1px); filter:hue-rotate(15deg); }
    30%{ transform:translate(2px,-1px); filter:none; }
    45%{ transform:translate(-1px,0); filter:hue-rotate(-10deg); }
    60%{ transform:translate(1px,-1px); filter:none; }
    100%{ transform:translate(0,0); filter:none; }
  }

  @keyframes cc-white-flash{
    0%{ box-shadow:inset 0 0 0 999px rgba(255,255,255,0); }
    10%{ box-shadow:inset 0 0 0 999px rgba(255,255,255,0.22); }
    25%{ box-shadow:inset 0 0 0 999px rgba(255,255,255,0); }
  }

  @keyframes cc-edge-flash{
    0%,100%{ opacity:0; }
    12%,28%{ opacity:0.7; }
    20%{ opacity:0; }
  }

  @keyframes cc-rgb-split{
    0%{ text-shadow:none; }
    15%{ text-shadow:-1.5px 0 #ff2d55, 1.5px 0 #2dd4ff; }
    30%{ text-shadow:1px 0 #ff2d55, -1px 0 #2dd4ff; }
    100%{ text-shadow:none; }
  }

  @keyframes cc-static-noise{
    0%{ opacity:0.5; }
    50%{ opacity:0.9; }
    100%{ opacity:0.5; }
  }

  /* ---------- selected: yellow + scanline sweep ---------- */
  .cc-card.is-selected{
    background:var(--yellow);
    color:var(--navy-deep);
    box-shadow:
      inset 1px 1px 0 rgba(255,255,255,0.5),
      inset -1px -1px 0 rgba(0,10,40,0.25);
  }

  .cc-card.is-selected .cc-card__title,
  .cc-card.is-selected .cc-card__meta{
    color:var(--navy-deep);
    opacity:1;
  }

  .cc-card.is-selected::after{
    content:"";
    position:absolute;
    left:0; right:0;
    height:6px;
    background:rgba(255,255,255,0.6);
    top:-6px;
    opacity:1;
    animation:cc-scanline-sweep 1.8s linear infinite;
  }

  @keyframes cc-scanline-sweep{
    0%{ top:-6px; }
    100%{ top:100%; }
  }
</style>

<script>
  if (!(window as any).__ccCardHandlersInit) {
    (window as any).__ccCardHandlersInit = true;

    document.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.cc-card') as HTMLElement | null;
      if (!card) return;

      const group = card.dataset.group;
      if (group) {
        document
          .querySelectorAll(`.cc-card[data-group="${group}"].is-selected`)
          .forEach((el) => {
            if (el !== card) el.classList.remove('is-selected');
          });
      }
      card.classList.toggle('is-selected');
    });

    document.addEventListener('dblclick', (e) => {
      const card = (e.target as HTMLElement).closest('.cc-card') as HTMLElement | null;
      if (!card) return;
      const href = card.dataset.href;
      if (href) window.location.href = href;
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const card = (e.target as HTMLElement).closest('.cc-card') as HTMLElement | null;
      if (!card) return;
      e.preventDefault();
      const href = card.dataset.href;
      if (href) window.location.href = href;
    });
  }
</script>