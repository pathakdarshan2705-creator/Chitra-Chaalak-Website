---
// src/components/Card.astro
//
// <Card href="..." title="..." meta="..." imageSrc="..." group="films" variant="poster" />
//
// variant:
//   "default" — landscape thumbnail + text (tour, collections)
//   "poster"  — portrait movie-poster shaped thumbnail (film recommendations)
//   "text"    — no image, full-width text bar (blog channel-list rows)
//
// Single click selects. Same `group` on every card in a list makes
// selection exclusive within that list. Double-click navigates to
// `href`. Up/down + Enter in the parent Panel drive the same state.

interface Props {
  href: string;
  title: string;
  meta?: string;
  imageSrc?: string;
  imageAlt?: string;
  group?: string;
  variant?: 'default' | 'poster' | 'text';
}

const { href, title, meta, imageSrc = '', imageAlt = '', group, variant = 'default' } = Astro.props;
const isRemote = imageSrc.startsWith('http');
const optimizedSrc = isRemote && imageSrc.includes('unsplash.com') 
  ? (imageSrc.includes('?') ? imageSrc + '&w=800&q=70&auto=format' : imageSrc + '?w=800&q=70&auto=format')
  : imageSrc;
---
<div
  class={`cc-card cc-card--${variant}`}
  data-href={href}
  data-group={group ?? ''}
  data-title={title}
  data-meta={meta ?? ''}
  data-image={imageSrc}
  tabindex="0"
  role="button"
  aria-label={`${title}. Click to select, double-click to open.`}
>
  {variant !== 'text' && (
    <div class="cc-card__img">
      <img src={optimizedSrc} alt={imageAlt} loading="lazy" />
    </div>
  )}
  <div class="cc-card__body">
    <div class="cc-card__title">{title}</div>
    {meta && <div class="cc-card__meta">{meta}</div>}
  </div>
  <span class="cc-card__corner-br" aria-hidden="true"></span>
</div>

<style is:global>
  .cc-card{
    position:relative;
    display:flex;
    gap:12px;
    align-items:flex-start;
    background:var(--blue-card);
    padding:12px;
    cursor:pointer;
    outline:none;
    width:100%;
    border:2px solid var(--navy-deep);
    box-shadow:
      inset 0 0 0 2px var(--blue-panel-light),
      inset 0 0 0 3px var(--navy-deep),
      inset 1px 1px 0 rgba(255,255,255,0.2),
      inset -1px -1px 0 rgba(0,10,40,0.35);
      
    /* Smooth cinematic transition */
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease, border-color 0.4s ease, background 0.4s ease;
  }

  .cc-card::before{
    content:"";
    position:absolute;
    top:3px; left:3px;
    width:8px; height:8px;
    border-top:2px solid var(--blue-panel-light);
    border-left:2px solid var(--blue-panel-light);
    opacity:0.8;
    pointer-events:none;
    z-index:1;
  }

  .cc-card__corner-br{
    position:absolute;
    bottom:3px; right:3px;
    width:8px; height:8px;
    border-bottom:2px solid var(--blue-panel-light);
    border-right:2px solid var(--blue-panel-light);
    opacity:0.8;
    pointer-events:none;
    z-index:1;
  }

  /* Cinematic Hover */
  .cc-card:hover,
  .cc-card:focus-visible {
    transform: scale(1.02) translateY(-2px);
    border-color: var(--yellow);
    box-shadow:
      inset 0 0 0 2px var(--yellow),
      inset 0 0 0 3px var(--navy-deep),
      0 10px 30px rgba(0, 10, 40, 0.6),
      0 0 15px rgba(255, 240, 0, 0.15);
    background: var(--blue-card-hover);
    z-index: 10;
  }

  .cc-card__img{
    flex:0 0 clamp(56px, 8vw, 96px);
    aspect-ratio:4 / 3;
    background:var(--blue-panel-light);
    overflow:hidden;
    box-shadow:inset 0 0 0 1px rgba(0,10,40,0.3);
  }

  .cc-card__img img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Image zoom on hover */
  .cc-card:hover .cc-card__img img,
  .cc-card:focus-visible .cc-card__img img {
    transform: scale(1.08);
  }

  .cc-card--poster{
    flex-direction:column;
    align-items:stretch;
    height:100%;
    width:150px;
    flex:0 0 150px;
    justify-self:start;
  }

  .cc-card--poster .cc-card__img{
    flex:1;
    min-height:0;
    width:100%;
  }

  .cc-card--text{
    padding: 10px 14px;
  }

  .cc-card__body{ min-width:0; }

  .cc-card__title{
    font-family:var(--font-ui);
    font-weight:600;
    font-size:clamp(11px, 0.85vw, 13px);
    text-transform:uppercase;
    letter-spacing:0.5px;
    color:var(--blue-lightest);
    margin-bottom:2px;
    line-height:1.3;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), color 0.4s ease;
  }

  .cc-card--text .cc-card__title{
    margin-bottom:2px;
    font-size:clamp(12px, 0.95vw, 14px);
  }

  .cc-card__meta{
    font-family:var(--font-body);
    font-size:clamp(11px, 0.85vw, 13px);
    color:var(--blue-lightest);
    opacity:0.7;
    line-height:1.3;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Text slide on hover */
  .cc-card:hover .cc-card__title,
  .cc-card:hover .cc-card__meta,
  .cc-card:focus-visible .cc-card__title,
  .cc-card:focus-visible .cc-card__meta {
    transform: translateX(4px);
  }
  .cc-card:hover .cc-card__title,
  .cc-card:focus-visible .cc-card__title {
    color: var(--yellow);
  }

  .cc-card.is-selected{
    border-color:var(--yellow);
    background:var(--blue-card-hover);
    box-shadow:
      inset 0 0 0 2px var(--yellow),
      inset 0 0 0 3px var(--navy-deep);
  }

  .cc-card.is-selected .cc-card__title{
    color:var(--yellow);
  }

  .cc-card.is-selected::after{
    content:"";
    position:absolute;
    inset:0;
    border:2px solid var(--yellow);
    pointer-events:none;
    animation:cc-breathe 2s ease-in-out infinite;
    z-index:2;
  }
</style>