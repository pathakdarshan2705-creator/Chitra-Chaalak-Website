---
// src/components/CardInteractions.astro
//
// Extracted from Card.astro so this logic is guaranteed present on
// EVERY page, not just ones that happen to render a <Card> component
// directly. Astro only bundles a component's script when that exact
// component is used on the page — CassetteCard, UpdateEntryCard,
// SlideshowCard, and BlogGridCard all reuse the `.cc-card` class but
// are separate components, so without this extraction, a page using
// only e.g. BlogGridCard would silently have no click/dblclick behavior.
// Mounted once in Layout.astro alongside RemoteControl, FocusFrame, etc.
---
<script>
  // @ts-nocheck
  if (!window.__ccCardHandlersInit) {
    window.__ccCardHandlersInit = true;

    // Single click interaction for mouse across the entire website
    document.addEventListener('click', (e) => {
      // Don't intercept clicks inside buttons, inputs, textareas, or explicit jump links
      if (e.target.closest('button, input, textarea, select, .cc-farmaish-jump-btn, [data-prevent-card-click]')) return;

      const card = e.target.closest('.cc-card');
      if (!card) return;

      const href = card.dataset.href;
      const group = card.dataset.group;

      // Remove any lingering selection on other cards
      document.querySelectorAll('.cc-card.is-selected').forEach((el) => {
        el.classList.remove('is-selected');
      });

      // Momentary yellow box line for visual feedback (fraction of a second)
      card.classList.add('is-clicked');

      if (href && href !== '#') {
        // Unified ChannelWipe transition for all cards across the site
        document.dispatchEvent(new CustomEvent('cc:channel-jump'));
        setTimeout(() => {
          card.classList.remove('is-clicked');
          window.location.href = href;
        }, 220);
      } else {
        setTimeout(() => {
          card.classList.remove('is-clicked');
        }, 180);
      }

      if (group) {
        document.dispatchEvent(new CustomEvent('cc:card-selected', { detail: { group, card } }));
      }
    });

    // Clear lingering keyboard selection on mousedown outside
    document.addEventListener('mousedown', (e) => {
      if (!e.target.closest('.cc-card')) {
        document.querySelectorAll('.cc-card.is-selected').forEach((el) => {
          el.classList.remove('is-selected');
        });
      }
    });

    // Keyboard support: Enter or Space on a focused card opens it
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const active = document.activeElement;
        if (active && active.classList && active.classList.contains('cc-card')) {
          const href = active.dataset.href;
          if (href && href !== '#') {
            e.preventDefault();
            active.classList.add('is-clicked');
            document.dispatchEvent(new CustomEvent('cc:channel-jump'));
            setTimeout(() => {
              active.classList.remove('is-clicked');
              window.location.href = href;
            }, 220);
          }
        }
      }
    });
  }
</script>
