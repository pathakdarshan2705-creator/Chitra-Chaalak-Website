---
// src/components/ContactCard.astro
// Static — not a page. Swap the `links` array for your real handles.

import Icon from './Icons.astro';

const links = [
  { label: 'Instagram', href: 'https://instagram.com/yourhandle' },
  { label: 'Email', href: 'mailto:you@example.com' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/yourhandle' },
  { label: 'Behance', href: 'https://behance.net/yourhandle' },
];
---
<div class="cc-contact">
  <div class="cc-contact__header">
    <span class="cc-contact__label">Get in Touch</span>
    <span class="cc-contact__phone"><Icon name="phone" size={18} /></span>
  </div>
  <ul class="cc-contact__list">
    {links.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
      </li>
    ))}
  </ul>
</div>

<style>
  .cc-contact{
    background:var(--blue-column);
    border:1px solid rgba(166,232,255,0.3);
    padding:14px;
  }

  .cc-contact__header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:10px;
  }

  .cc-contact__label{
    font-family:var(--font-ui);
    font-size:11px;
    letter-spacing:1.5px;
    text-transform:uppercase;
    color:var(--yellow);
  }

  .cc-contact__phone{
    color:var(--blue-lightest);
    opacity:0.8;
  }

  .cc-contact__list{
    list-style:none;
    margin:0;
    padding:0;
    display:flex;
    flex-direction:column;
    gap:6px;
  }

  .cc-contact__list a{
    font-family:var(--font-body);
    font-size:clamp(14px, 1.1vw, 16px);
    font-weight:600;
    color:var(--blue-lightest);
    transition:color 0.1s steps(2);
  }

  .cc-contact__list a:hover{
    color:var(--yellow);
  }
</style>