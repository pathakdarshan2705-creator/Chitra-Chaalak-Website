---
// src/components/MusicListItem.astro
interface Props {
  title: string;
  artist: string;
  coverImage: string;
  spotifyLink?: string;
  youtubeLink?: string;
  year?: string;
}

const { title, artist, coverImage, spotifyLink = "#", youtubeLink = "#", year = "" } = Astro.props;
---

<div class="music-list-item">
  <div class="music-cover-wrapper">
    <img src={coverImage} alt={title} class="music-cover" />
    <div class="music-vinyl"></div>
  </div>
  <div class="music-info">
    <h3 class="music-title">{title}</h3>
    <p class="music-artist">{artist}</p>
  </div>
  {year && <div class="music-year">{year}</div>}
  <div class="music-links">
    {spotifyLink && (
      <a href={spotifyLink} target="_blank" rel="noopener noreferrer" class="music-link" title="Spotify">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.6.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.239.54-.959.72-1.56.3z" /></svg>
      </a>
    )}
    {youtubeLink && (
      <a href={youtubeLink} target="_blank" rel="noopener noreferrer" class="music-link" title="YouTube">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.582,6.186c-0.23-0.86-0.908-1.538-1.768-1.768C18.254,4,12,4,12,4S5.746,4,4.186,4.418c-0.86,0.23-1.538,0.908-1.768,1.768C2,7.746,2,12,2,12s0,4.254,0.418,5.814c0.23,0.86,0.908,1.538,1.768,1.768C5.746,20,12,20,12,20s6.254,0,7.814-0.418c0.861-0.23,1.538-0.908,1.768-1.768C22,16.254,22,12,22,12S22,7.746,21.582,6.186z M10,15.464V8.536L16,12L10,15.464z" /></svg>
      </a>
    )}
  </div>
</div>

<style>
  .music-list-item {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    background: transparent;
    border-bottom: 1px solid var(--blue-panel-light);
    transition: background 0.2s, transform 0.2s;
    gap: 20px;
    font-family: var(--font-body);
  }

  .music-list-item:hover {
    background: rgba(103, 200, 255, 0.1);
    transform: translateX(5px);
  }

  .music-cover-wrapper {
    position: relative;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
  }

  .music-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    position: relative;
    z-index: 2;
    border: 1px solid var(--navy-deep);
  }

  .music-vinyl {
    position: absolute;
    top: 5%;
    right: 5%;
    width: 90%;
    height: 90%;
    background: #111;
    border-radius: 50%;
    z-index: 1;
    transition: transform 0.4s ease;
  }

  .music-list-item:hover .music-vinyl {
    transform: translateX(15px) rotate(180deg);
  }

  .music-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .music-title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
    color: var(--yellow);
    text-transform: uppercase;
  }

  .music-artist {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .music-year {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--blue-lightest);
    opacity: 0.7;
    margin-right: 20px;
  }

  .music-links {
    display: flex;
    gap: 10px;
  }

  .music-link {
    color: var(--blue-panel-light);
    transition: color 0.2s, transform 0.2s;
  }

  .music-link:hover {
    color: var(--yellow);
    transform: scale(1.1);
  }
</style>
