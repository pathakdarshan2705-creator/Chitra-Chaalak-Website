---
// Arrow and Info icons, plus a few others. Used in Card.astro and elsewhere.

interface Props {
  name: 'arrow' | 'info' | 'dots' | 'phone' | 'triangle' | 'chevron-up' | 'chevron-down';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---

{name === 'arrow' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 12h14M12 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === 'info' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.8" fill="none"/>
    <rect x="11" y="10" width="2" height="7" fill="currentColor"/>
    <rect x="11" y="6.5" width="2" height="2" fill="currentColor"/>
  </svg>
)}

{name === 'dots' && (
  <svg width={size} height={size * 0.3} viewBox="0 0 24 7" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="0" y="0" width="6" height="6" fill="currentColor"/>
    <rect x="9" y="0" width="6" height="6" fill="currentColor"/>
    <rect x="18" y="0" width="6" height="6" fill="currentColor"/>
  </svg>
)}

{name === 'phone' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2 2C10.5 19.5 4.5 13.5 4.5 5a2 2 0 0 1 2-2z" fill="currentColor"/>
  </svg>
)}

{name === 'triangle' && (
  <svg width={size * 0.6} height={size * 0.6} viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 1l8 5-8 5V1z" fill="currentColor"/>
  </svg>
)}

{name === 'chevron-up' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M5 15l7-7 7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === 'chevron-down' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M5 9l7 7 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}