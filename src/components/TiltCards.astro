---
// src/components/TiltCards.astro
//
// Every .cc-card tilts in 3D toward the cursor on hover, with a glare
// highlight that tracks the mouse across its surface — like glass
// catching light. Highly optimized with rAF throttling and cached rects
// to prevent layout thrashing and maintain 60+ FPS.
---
<style>
  .cc-card, .cc-cassette, .cc-slideshow, .cc-update-entry {
    transform-style: preserve-3d;
    will-change: transform;
  }
  .cc-tilt-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle 140px at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255,255,255,0.18),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.2s ease-out;
    z-index: 5;
  }
  .cc-tilt-glare.is-active { opacity: 1; }
</style>

<script>
  // @ts-nocheck
  if (!window.__ccTiltCardsInit) {
    window.__ccTiltCardsInit = true;

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      import('gsap').then(({ gsap }) => {
        const TARGETS = '.cc-card, .cc-cassette, .cc-slideshow, .cc-update-entry';
        const MAX_TILT = 5; // subtle, responsive tilt
        const registry = new WeakMap();

        function ensureGlare(el) {
          let glare = el.querySelector('.cc-tilt-glare');
          if (!glare) {
            glare = document.createElement('div');
            glare.className = 'cc-tilt-glare';
            el.appendChild(glare);
          }
          return glare;
        }

        function setup(el) {
          if (registry.has(el)) return registry.get(el);
          const rotX = gsap.quickTo(el, 'rotationX', { duration: 0.25, ease: 'power2.out' });
          const rotY = gsap.quickTo(el, 'rotationY', { duration: 0.25, ease: 'power2.out' });
          gsap.set(el, { transformPerspective: 800, transformOrigin: 'center' });
          const entry = { rotX, rotY, glare: ensureGlare(el) };
          registry.set(el, entry);
          return entry;
        }

        let activeCard = null;
        let cardRect = null;
        let currentEntry = null;
        let lastX = 0;
        let lastY = 0;
        let rafId = null;

        function renderTilt() {
          rafId = null;
          if (!activeCard || !cardRect || !currentEntry) return;

          const px = (lastX - cardRect.left) / cardRect.width;
          const py = (lastY - cardRect.top) / cardRect.height;

          currentEntry.rotY((px - 0.5) * MAX_TILT * 2);
          currentEntry.rotX(-(py - 0.5) * MAX_TILT * 2);

          currentEntry.glare.style.setProperty('--glare-x', `${px * 100}%`);
          currentEntry.glare.style.setProperty('--glare-y', `${py * 100}%`);
          currentEntry.glare.classList.add('is-active');
        }

        // Cache bounding rect once on enter, avoiding layout thrashing during moves
        document.addEventListener('mouseover', (e) => {
          const target = (e.target as HTMLElement)?.closest(TARGETS);
          if (target && target !== activeCard) {
            activeCard = target;
            cardRect = activeCard.getBoundingClientRect();
            currentEntry = setup(activeCard);
          }
        }, { passive: true });

        document.addEventListener('mousemove', (e) => {
          if (!activeCard) return; // Zero work done when cursor is anywhere else
          lastX = e.clientX;
          lastY = e.clientY;
          if (!rafId) {
            rafId = requestAnimationFrame(renderTilt);
          }
        }, { passive: true });

        document.addEventListener('mouseout', (e) => {
          if (!activeCard) return;
          const related = e.relatedTarget as HTMLElement | null;
          if (related && related.closest(TARGETS) === activeCard) return;

          if (currentEntry) {
            currentEntry.rotX(0);
            currentEntry.rotY(0);
            currentEntry.glare.classList.remove('is-active');
          }
          activeCard = null;
          cardRect = null;
          currentEntry = null;
        }, { passive: true });

        window.addEventListener('scroll', () => {
          if (activeCard) cardRect = activeCard.getBoundingClientRect();
        }, { passive: true });
      });
    }
  }
</script>