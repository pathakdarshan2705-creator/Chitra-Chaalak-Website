---
// src/components/SidebarNav.astro
//
// Left navigation panel for every inner page (blog, portfolio, film,
// tour, collections, updates — NOT the home page, which keeps its own
// 3-column layout). Two parts:
// 1. A grid of links to every section, current page highlighted yellow.
// 2. The current page's own title/description + control buttons — these
//    are wired to `controlGroup` using the exact same data-select-group /
//    data-enter-group / data-info-group mechanism Panel.astro already
//    uses, so they control whatever list is on screen with zero new
//    interaction logic.
//
// Pairs with .cc-inner-layout / .cc-inner-content (global.css) which
// handle the "sidebar pinned, content scrolls independently" structure.

import Icon from './Icons.astro';

interface NavItem { label: string; href: string; key: string; }

const NAV_ITEMS: NavItem[] = [
  { label: 'In the Meantime', href: '/updates', key: 'updates' },
  { label: 'Making Sense', href: '/blog', key: 'blog' },
  { label: 'Portfolio', href: '/portfolio', key: 'portfolio' },
  { label: 'The Film Shelf', href: '/films', key: 'films' },
  { label: 'Visual Tours', href: '/tour', key: 'tour' },
  { label: 'My Collection', href: '/collections', key: 'collections' },
];

interface Props {
  activePage: string;      // must match a NAV_ITEMS[].key
  pageTitle: string;
  pageDescription?: string;
  controlGroup?: string;   // data-group whose selection the buttons control
  infoTitle?: string;
  infoMeta?: string;
}

const {
  activePage,
  pageTitle,
  pageDescription = 'Below mentioned control buttons are for the page which is open',
  controlGroup,
  infoTitle,
  infoMeta,
} = Astro.props;
---
<nav class="cc-sidebar">
  <button class="cc-sidebar__hamburger" id="cc-sidebar-hamburger" aria-label="Toggle navigation" aria-expanded="false">
    <div class="cc-sidebar__hamburger-icon">
      <span></span><span></span><span></span>
    </div>
    <span class="cc-sidebar__hamburger-title">{pageTitle}</span>
  </button>
  <div class="cc-sidebar__grid" id="cc-sidebar-grid">
    {NAV_ITEMS.map((item) => (
      <a
        href={item.href}
        class={`cc-sidebar__link ${item.key === activePage ? 'is-active' : ''}`}
      >
        {item.label}
      </a>
    ))}
  </div>

  <div class="cc-sidebar__footer mobile-hidden">
    <div class="cc-sidebar__title">{pageTitle}</div>
    <div class="cc-sidebar__desc" set:html={pageDescription}></div>

    {controlGroup && (
      <div class="cc-sidebar__controls">
        <div class="cc-sidebar__scroll-btns">
          <button class="cc-icon-btn" data-select-group={controlGroup} data-dir="-1" aria-label="Select previous">
            <Icon name="chevron-up" size={14} />
          </button>
          <button class="cc-icon-btn" data-select-group={controlGroup} data-dir="1" aria-label="Select next">
            <Icon name="chevron-down" size={14} />
          </button>
        </div>
        <button class="cc-sidebar__enter" data-enter-group={controlGroup}>Enter</button>
        <button class="cc-icon-btn" data-info-group={controlGroup} data-info-title={infoTitle} data-info-meta={infoMeta} aria-label="Preview selected">
          <Icon name="info" size={17} />
        </button>
      </div>
    )}
  </div>
</nav>

<style is:global>
  .cc-sidebar{
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cc-sidebar__grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    flex-shrink: 0;
  }

  .cc-sidebar__link{
    background: var(--blue-card);
    position:relative;
    display:block;
    font-family:var(--font-ui);
    font-weight:700;
    font-size:clamp(11px, 0.9vw, 13px);
    text-transform:uppercase;
    text-decoration:none;
    color:var(--blue-lightest);
    padding:12px 14px;
    letter-spacing:1px;
    background:transparent;
    border:2px solid var(--blue-panel-light);
    outline:none;
    cursor:pointer;
    overflow: hidden;
    transition: color 0.4s ease, border-color 0.4s ease;
    z-index: 1;
    text-align: center;
  }

  .cc-sidebar__link::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--yellow);
    transform: translateX(-101%);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    z-index: -1;
  }

  .cc-sidebar__link:hover::before,
  .cc-sidebar__link.is-active::before {
    transform: translateX(0);
  }

  .cc-sidebar__link:hover,
  .cc-sidebar__link.is-active{
    color:var(--navy-deep);
    border-color: var(--yellow);
  }

  .cc-sidebar__footer{
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--blue-column);
    border: 2px solid var(--navy-deep);
    box-shadow:
      inset 0 0 0 2px var(--blue-panel-light),
      inset 0 0 0 3px var(--navy-deep);
    padding: 16px;
  }

  .cc-sidebar__title{
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(14px, 1.2vw, 18px);
    letter-spacing: 0.5px;
    color: var(--blue-lightest);
    margin-bottom: 8px;
  }

  .cc-sidebar__desc{
    font-family: var(--font-body);
    font-size: clamp(11px, 0.95vw, 13px);
    color: var(--blue-lightest);
    opacity: 0.65;
    line-height: 1.4;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .cc-sidebar__desc::-webkit-scrollbar { display: none; }

  .cc-sidebar__controls{
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    margin-top: 12px;
  }

  .cc-sidebar__scroll-btns{ display: flex; gap: 4px; }

  .cc-sidebar__enter{
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    flex: 1;
    text-align: center;
    background: var(--navy-deep);
    border: 1px solid rgba(0,0,0,0.3);
    color: var(--blue-lightest);
    padding: 6px 0;
    cursor: pointer;
    transition: background 0.1s steps(2), color 0.1s steps(2);
  }
  .cc-sidebar__enter:hover{ background: var(--yellow); color: var(--navy-deep); }

  .cc-sidebar__hamburger{ display: none; } /* shown only on mobile — see global.css */

  @media (max-width: 768px) {
    .mobile-hidden {
      display: none !important;
    }
  }
</style>

<script>
  // @ts-nocheck
  if (!window.__ccSidebarHamburgerInit) {
    window.__ccSidebarHamburgerInit = true;
    const btn = document.getElementById('cc-sidebar-hamburger');
    const grid = document.getElementById('cc-sidebar-grid');
    btn?.addEventListener('click', () => {
      const isOpen = grid?.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(!!isOpen));
    });
    grid?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        grid.classList.remove('is-open');
        btn?.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>