---
// Little transition image that comes up before the page loads or if someone refreshes
---
<div class="cc-testcard" id="cc-testcard" aria-hidden="true">
  <div class="cc-testcard__bars">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span>
  </div>

  <div class="cc-testcard__grid">
    <div class="cc-testcard__reticle">
      <span class="cc-testcard__crosshair-v"></span>
      <span class="cc-testcard__crosshair-h"></span>
      <span class="cc-testcard__circle"></span>
    </div>
  </div>

  <div class="cc-testcard__id">
    <span class="cc-testcard__id-name">CHITRA-CHAALAK</span>
    <span class="cc-testcard__id-loading">IS LOADING...</span>
  </div>

  <div class="cc-testcard__noise"></div>
</div>

<style>
  .cc-testcard{
    position:fixed;
    inset:0;
    z-index:5000;
    background:#111;
    display:flex;
    flex-direction:column;
    opacity:1;
    transition:opacity 0.5s steps(6);
  }

  .cc-testcard.cc-testcard--tuning{
    animation:cc-tune-flicker 0.4s steps(2) 3;
  }

  .cc-testcard.cc-testcard--out{
    opacity:0;
    pointer-events:none;
  }

  .cc-testcard.cc-testcard--gone{
    display:none;
  }

  @keyframes cc-tune-flicker{
    0%,100%{ filter:brightness(1); }
    50%{ filter:brightness(1.4) saturate(1.3); }
  }

  .cc-testcard__bars{
    flex:1;
    display:flex;
  }

  .cc-testcard__bars span{ flex:1; }
  .cc-testcard__bars span:nth-child(1){ background:#c0c0c0; }
  .cc-testcard__bars span:nth-child(2){ background:#c0c000; }
  .cc-testcard__bars span:nth-child(3){ background:#00c0c0; }
  .cc-testcard__bars span:nth-child(4){ background:#00c000; }
  .cc-testcard__bars span:nth-child(5){ background:#c000c0; }
  .cc-testcard__bars span:nth-child(6){ background:#c00000; }
  .cc-testcard__bars span:nth-child(7){ background:#0000c0; }

  .cc-testcard__grid{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    pointer-events:none;
  }

  .cc-testcard__reticle{
    position:relative;
    width:120px;
    height:120px;
  }

  .cc-testcard__crosshair-v,
  .cc-testcard__crosshair-h{
    position:absolute;
    background:rgba(255,255,255,0.8);
  }

  .cc-testcard__crosshair-v{
    left:50%; top:0; bottom:0;
    width:2px;
    transform:translateX(-50%);
  }

  .cc-testcard__crosshair-h{
    top:50%; left:0; right:0;
    height:2px;
    transform:translateY(-50%);
  }

  .cc-testcard__circle{
    position:absolute;
    inset:0;
    border:2px solid rgba(255,255,255,0.8);
    border-radius:50%;
  }

  .cc-testcard__id{
    position:absolute;
    bottom:14%;
    left:50%;
    transform:translateX(-50%);
    text-align:center;
    font-family:var(--font-ui);
    color:#fff;
  }

  .cc-testcard__id-name{
    display:block;
    font-size:clamp(24px, 3vw, 42px); /* Made it slightly larger */
    font-weight:700;
    letter-spacing:6px;
    margin-bottom:8px;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.5); /* Glowing effect */
  }

  .cc-testcard__id-loading{
    display:block;
    font-family: var(--font-ui, 'IBM Plex Mono', monospace);
    font-size:clamp(12px, 1.2vw, 16px);
    letter-spacing:4px;
    color: var(--yellow, #fff000);
    animation:cc-pulse-dot 1.5s ease-in-out infinite;
  }

  @keyframes cc-pulse-dot{
    0%,100%{ opacity:1; }
    50%{ opacity:0.2; }
  }

  .cc-testcard__noise{
    position:absolute;
    inset:0;
    pointer-events:none;
    background-image:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.06) 0px, transparent 1px, transparent 3px);
    mix-blend-mode:overlay;
  }
</style>

<script>
  // @ts-nocheck
import { gsap } from 'gsap';

  (function () {
    const KEY = 'cc-testcard-seen';
    const el = document.getElementById('cc-testcard');
    if (!el) return;

    const panels = document.querySelectorAll('.cc-panel, .cc-contact-panel');

    function powerOnReveal() {
      gsap.set(panels, { opacity: 0, scale: 0.94, filter: 'brightness(2.5)' });
      gsap.to(panels, {
        opacity: 1,
        scale: 1,
        filter: 'brightness(1)',
        duration: 0.35,
        ease: 'power1.out',
        stagger: { each: 0.06, from: 'start', grid: 'auto' },
      });
    }

    if (sessionStorage.getItem(KEY)) {
      el.classList.add('cc-testcard--gone');
      gsap.set(panels, { opacity: 1, scale: 1, filter: 'none' });
      return;
    }
    sessionStorage.setItem(KEY, '1');
    gsap.set(panels, { opacity: 0 });

    setTimeout(() => el.classList.add('cc-testcard--tuning'), 1100);
    setTimeout(() => el.classList.add('cc-testcard--out'), 1500);
    setTimeout(() => { el.classList.add('cc-testcard--gone'); powerOnReveal(); }, 1600);
  })();
</script>