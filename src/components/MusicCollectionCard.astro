---
// src/components/MusicCollectionCard.astro
interface Props {
  title: string;
  artist: string;
  coverImage: string;
  spotifyLink?: string;
  youtubeLink?: string;
  year?: string;
}

const { title, artist, coverImage, spotifyLink = "#", youtubeLink = "#", year = "2026" } = Astro.props;
---

<div class="cc-music-card">
  <div class="music-card-inner">
    <!-- Vinyl Record (hidden behind poster initially) -->
    <div class="vinyl-record">
      <div class="vinyl-grooves"></div>
      <div class="vinyl-label">
        <span class="label-text">{artist}</span>
        <div class="vinyl-hole"></div>
        <span class="label-year">{year}</span>
      </div>
    </div>
    
    <!-- Poster Sleeve -->
    <div class="poster-sleeve">
      <img src={coverImage} alt={`${title} by ${artist}`} class="poster-img" />
      <div class="poster-overlay">
        <h3 class="track-title">{title}</h3>
        <p class="track-artist">{artist}</p>
        
        <div class="links-container">
          {spotifyLink && (
            <a href={spotifyLink} target="_blank" rel="noopener noreferrer" class="music-link spotify" aria-label="Listen on Spotify">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.6.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.239.54-.959.72-1.56.3z" />
              </svg>
            </a>
          )}
          {youtubeLink && (
            <a href={youtubeLink} target="_blank" rel="noopener noreferrer" class="music-link youtube" aria-label="Listen on YouTube">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.582,6.186c-0.23-0.86-0.908-1.538-1.768-1.768C18.254,4,12,4,12,4S5.746,4,4.186,4.418c-0.86,0.23-1.538,0.908-1.768,1.768C2,7.746,2,12,2,12s0,4.254,0.418,5.814c0.23,0.86,0.908,1.538,1.768,1.768C5.746,20,12,20,12,20s6.254,0,7.814-0.418c0.861-0.23,1.538-0.908,1.768-1.768C22,16.254,22,12,22,12S22,7.746,21.582,6.186z M10,15.464V8.536L16,12L10,15.464z" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cc-music-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 350px;
    margin: 0 auto;
    perspective: 1000px;
    cursor: pointer;
    font-family: var(--font-body);
  }

  .music-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Sleeve / Poster */
  .poster-sleeve {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    background: var(--blue-card);
    border: 2px solid var(--blue-panel-light);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 5px 5px 15px rgba(0,0,0,0.3);
    transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.2) contrast(1.1); /* Slight retro punch */
  }

  /* Overlay for Track Info & Links */
  .poster-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(to top, var(--navy-deep) 0%, transparent 100%);
    padding: 20px 15px 15px;
    color: var(--blue-lightest);
    transform: translateY(100%);
    transition: transform 0.4s ease;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .cc-music-card:hover .poster-overlay {
    transform: translateY(0);
  }

  .track-title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .track-artist {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .links-container {
    display: flex;
    gap: 10px;
    margin-top: 10px;
  }

  .music-link {
    color: var(--blue-lightest);
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .music-link:hover {
    color: var(--yellow);
    transform: scale(1.1);
  }

  /* Vinyl Record */
  .vinyl-record {
    position: absolute;
    top: 5%;
    left: 5%;
    width: 90%;
    height: 90%;
    background: #111;
    border-radius: 50%;
    z-index: 5;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.8), 0 0 10px rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    /* Grooves effect */
    background-image: 
      radial-gradient(circle, transparent 40%, #1a1a1a 41%, transparent 42%),
      radial-gradient(circle, transparent 50%, #151515 51%, transparent 52%),
      radial-gradient(circle, transparent 60%, #1a1a1a 61%, transparent 62%),
      radial-gradient(circle, transparent 70%, #151515 71%, transparent 72%),
      radial-gradient(circle, transparent 80%, #1a1a1a 81%, transparent 82%);
  }

  .vinyl-label {
    width: 35%;
    height: 35%;
    background: var(--blue-column);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--yellow);
    color: var(--yellow);
    font-family: var(--font-ui);
    font-size: 0.6rem;
    text-align: center;
    position: relative;
    text-transform: uppercase;
  }

  .vinyl-hole {
    width: 10px;
    height: 10px;
    background: var(--navy-deep);
    border-radius: 50%;
    margin: 4px 0;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
  }

  /* Interactions */
  .cc-music-card:hover .music-card-inner {
    /* Slight lift on hover */
    transform: translateY(-5px);
  }
</style>

<script>
  import { gsap } from "gsap";

  // We initialize the GSAP animations for the cards
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll(".cc-music-card");

    cards.forEach((card) => {
      const vinyl = card.querySelector(".vinyl-record");
      const sleeve = card.querySelector(".poster-sleeve");

      // Setup timeline for each card
      const tl = gsap.timeline({ paused: true });

      // Slide vinyl out to the right and spin it
      tl.to(vinyl, {
        x: "50%",
        rotation: 180,
        duration: 0.6,
        ease: "power2.out"
      }, 0);

      // Slightly scale down sleeve for depth effect
      tl.to(sleeve, {
        scale: 0.95,
        x: "-5%",
        duration: 0.6,
        ease: "power2.out"
      }, 0);

      // Add infinite spin to vinyl once it's out
      const spin = gsap.to(vinyl, {
        rotation: "+=360",
        duration: 2,
        repeat: -1,
        ease: "none",
        paused: true
      });

      card.addEventListener("mouseenter", () => {
        tl.play();
        // start spinning after slide out completes
        gsap.delayedCall(0.6, () => spin.play());
      });

      card.addEventListener("mouseleave", () => {
        spin.pause();
        // Reset rotation so it reverses smoothly
        gsap.to(vinyl, {
          rotation: Math.round(gsap.getProperty(vinyl, "rotation") / 360) * 360,
          duration: 0.1,
          onComplete: () => tl.reverse()
        });
      });
    });
  });
</script>
