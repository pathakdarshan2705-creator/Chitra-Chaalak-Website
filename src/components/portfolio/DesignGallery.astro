---
const { projects } = Astro.props;
---
<div class="cc-design-gallery">
  <table class="cc-design-table">
    <thead>
      <tr>
        <th>PROJECT</th>
        <th>CATEGORY</th>
        <th>DATE</th>
        <th>PREVIEW</th>
      </tr>
    </thead>
    <tbody>
      {projects.map((project) => (
        <tr class="cc-design-row" onclick={`window.location.href='/portfolio/design/${project.slug}'`}>
          <td class="cc-col-title">
            <span class="cc-design-number">#</span>
            {project.data.title}
          </td>
          <td class="cc-col-cat">BRANDING / UI</td>
          <td class="cc-col-date">{project.data.date.getFullYear()}</td>
          <td class="cc-col-img">
            <div class="cc-design-img-wrap">
              <img src={project.data.image} alt={project.data.title} />
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .cc-design-gallery {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 20px;
    background: var(--navy-deep);
  }

  .cc-design-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
  }

  .cc-design-table th {
    text-align: left;
    padding: 20px;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--blue-panel-light);
    border-bottom: 1px solid var(--blue-panel-light);
  }

  .cc-design-row {
    cursor: pointer;
    transition: background 0.3s ease;
    border-bottom: 1px solid rgba(103, 200, 255, 0.2);
  }

  .cc-design-row td {
    padding: 30px 20px;
    vertical-align: middle;
  }

  .cc-col-title {
    font-size: 2vw;
    font-weight: 700;
    color: var(--blue-lightest);
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .cc-design-number {
    font-size: 14px;
    color: var(--yellow);
    margin-right: 10px;
    vertical-align: top;
  }

  .cc-col-cat, .cc-col-date {
    font-size: 14px;
    color: var(--blue-panel-light);
  }

  .cc-col-img {
    width: 150px;
  }

  .cc-design-img-wrap {
    width: 120px;
    height: 60px;
    overflow: hidden;
    position: relative;
    border-radius: 2px;
  }

  .cc-design-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: transform 0.5s ease, filter 0.5s ease;
  }

  /* HOVER */
  .cc-design-row:hover {
    background: rgba(103, 200, 255, 0.05);
  }
  .cc-design-row:hover .cc-col-title {
    color: var(--yellow);
  }
  .cc-design-row:hover .cc-design-img-wrap img {
    transform: scale(1.1);
    filter: grayscale(0%);
  }
</style>

<script>
  import { gsap } from 'gsap';
  
  gsap.from('.cc-design-row', {
    x: -50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: "power2.out"
  });
</script>
