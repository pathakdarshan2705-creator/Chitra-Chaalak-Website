---
const { projects } = Astro.props;
// Get the first project's image to show initially
const defaultImage = projects.length > 0 ? projects[0].data.image : '';
---
<div class="cc-design-split" id="design-split">
  <div class="cc-design-left">
    <table class="cc-design-table">
      <thead>
        <tr>
          <th>PROJECT</th>
          <th>CATEGORY</th>
          <th>DATE</th>
        </tr>
      </thead>
      <tbody class="cc-design-tbody">
        {projects.map((project, i) => (
          <tr class={`cc-design-row ${i === 0 ? 'is-active' : ''}`} data-image={project.data.image} onclick={`window.location.href='/portfolio/design/${project.slug}'`}>
            <td class="cc-col-title">
              <span class="cc-design-number">#</span>
              {project.data.title}
            </td>
            <td class="cc-col-cat">BRANDING / UI</td>
            <td class="cc-col-date">{project.data.date.getFullYear()}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  
  <div class="cc-design-right">
    <div class="cc-design-preview">
      <img src={defaultImage} alt="Design Preview" id="design-preview-img" />
      <div class="cc-preview-overlay"></div>
    </div>
  </div>
</div>

<style>
  .cc-design-split {
    display: flex;
    width: 100%;
    height: 100%;
    background: var(--navy-deep);
  }

  .cc-design-left {
    flex: 1;
    overflow-y: auto;
    padding: 40px;
  }

  .cc-design-right {
    flex: 1;
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid rgba(103, 200, 255, 0.1);
  }

  .cc-design-preview {
    width: 100%;
    height: 100%;
    max-height: 80vh;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .cc-design-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cc-preview-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0,20,50,0.8) 100%);
    pointer-events: none;
  }

  .cc-design-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
  }

  .cc-design-table th {
    text-align: left;
    padding: 20px;
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--blue-panel-light);
    border-bottom: 1px solid var(--blue-panel-light);
  }

  .cc-design-row {
    cursor: pointer;
    transition: all 0.3s ease;
    border-bottom: 1px solid rgba(103, 200, 255, 0.1);
    opacity: 1; /* Made consistent */
  }

  .cc-design-row.is-active, .cc-design-row:hover {
    background: rgba(103, 200, 255, 0.05);
  }

  .cc-design-row td {
    padding: 40px 20px;
    vertical-align: middle;
  }

  .cc-col-title {
    font-size: 1.5vw;
    font-weight: 700;
    color: var(--blue-lightest);
    text-transform: uppercase;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .cc-design-number {
    font-size: 14px;
    color: var(--yellow);
    margin-right: 10px;
    vertical-align: top;
  }

  .cc-col-cat, .cc-col-date {
    font-size: 14px;
    color: var(--blue-panel-light);
  }

  .cc-design-row.is-active .cc-col-title, .cc-design-row:hover .cc-col-title {
    color: var(--yellow);
    transform: translateX(20px);
  }
  
  @media (max-width: 900px) {
    .cc-design-split { flex-direction: column; }
    .cc-design-right { display: none; /* Hide preview on mobile */ }
  }
</style>

<script>
  import { gsap } from 'gsap';
  
  gsap.from('.cc-design-row', {
    x: -50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: "power2.out"
  });

  const rows = document.querySelectorAll('.cc-design-row');
  const previewImg = document.getElementById('design-preview-img') as HTMLImageElement;

  rows.forEach(row => {
    row.addEventListener('mouseenter', () => {
      // Remove active from all
      rows.forEach(r => r.classList.remove('is-active'));
      row.classList.add('is-active');

      // Update image
      const imgSrc = row.getAttribute('data-image');
      if (imgSrc && previewImg && previewImg.src !== imgSrc) {
        gsap.to(previewImg, {
          opacity: 0,
          scale: 1.05,
          duration: 0.3,
          onComplete: () => {
            previewImg.src = imgSrc;
            gsap.to(previewImg, {
              opacity: 1,
              scale: 1,
              duration: 0.6,
              ease: "power2.out"
            });
          }
        });
      }
    });
  });
</script>
