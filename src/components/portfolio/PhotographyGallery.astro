---
const { projects } = Astro.props;
---
<div class="cc-photo-gallery">
  <div class="cc-masonry-grid">
    {projects.map((project, i) => (
      <a href={`/portfolio/photography/${project.slug}`} class={`cc-photo-card cc-photo-card--${i % 3}`}>
        <img src={project.data.image} alt={project.data.title} class="cc-photo-img" />
        <div class="cc-photo-details">
          <h2 class="cc-photo-title">{project.data.title}</h2>
          <div class="cc-photo-date">{project.data.date.toLocaleDateString()}</div>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .cc-photo-gallery {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    padding: 20px;
    scrollbar-width: none;
  }
  .cc-photo-gallery::-webkit-scrollbar { display: none; }

  .cc-masonry-grid {
    column-count: 3;
    column-gap: 20px;
  }

  @media (max-width: 1024px) { .cc-masonry-grid { column-count: 2; } }
  @media (max-width: 768px) { .cc-masonry-grid { column-count: 1; } }

  .cc-photo-card {
    display: inline-block;
    width: 100%;
    margin-bottom: 20px;
    position: relative;
    overflow: hidden;
    break-inside: avoid;
    border-radius: 2px;
    border: 1px solid var(--blue-panel-light);
  }

  /* Randomize aspect ratios for masonry effect if all placeholders are same size */
  .cc-photo-card--0 .cc-photo-img { aspect-ratio: 4/5; }
  .cc-photo-card--1 .cc-photo-img { aspect-ratio: 16/9; }
  .cc-photo-card--2 .cc-photo-img { aspect-ratio: 1/1; }

  .cc-photo-img {
    width: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cc-photo-details {
    position: absolute;
    inset: auto 0 0 0;
    padding: 20px;
    background: linear-gradient(0deg, rgba(0, 59, 153, 0.9) 0%, transparent 100%);
    color: var(--blue-lightest);
    transform: translateY(100%);
    transition: transform 0.4s ease;
  }

  .cc-photo-title {
    font-family: var(--font-ui);
    font-size: 16px;
    text-transform: uppercase;
    margin: 0 0 5px 0;
    color: var(--yellow);
  }

  .cc-photo-date {
    font-family: var(--font-ui);
    font-size: 11px;
    opacity: 0.8;
  }

  .cc-photo-card:hover .cc-photo-img {
    transform: scale(1.08);
  }
  .cc-photo-card:hover .cc-photo-details {
    transform: translateY(0);
  }
</style>

<script>
  import { gsap } from 'gsap';
  
  gsap.from('.cc-photo-card', {
    y: 50,
    opacity: 0,
    duration: 0.8,
    stagger: 0.1,
    ease: "power2.out"
  });
</script>
