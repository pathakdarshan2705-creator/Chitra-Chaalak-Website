---
const { projects } = Astro.props;
---
<div class="cc-film-gallery">
  <div class="cc-film-track">
    {projects.map((project, i) => (
      <a href={`/portfolio/filmmaking/${project.slug}`} class="cc-film-card">
        <div class="cc-film-number">SCENE {String(i + 1).padStart(2, '0')}</div>
        <div class="cc-film-image-wrapper">
          <img src={project.data.image} alt={project.data.title} class="cc-film-image" />
          <div class="cc-film-overlay">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
          </div>
        </div>
        <div class="cc-film-info">
          <h2 class="cc-film-title">{project.data.title}</h2>
          <p class="cc-film-desc">{project.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .cc-film-gallery {
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    display: flex;
    align-items: center;
  }
  .cc-film-gallery::-webkit-scrollbar { display: none; }

  .cc-film-track {
    display: flex;
    gap: 40px;
    padding: 0 40px;
    height: 70vh;
  }

  .cc-film-card {
    scroll-snap-align: center;
    flex: 0 0 70vw; /* Cinematic widescreen ratio */
    max-width: 900px;
    height: 100%;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    group: film-card;
  }

  .cc-film-number {
    font-family: var(--font-ui);
    color: var(--yellow);
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 10px;
  }

  .cc-film-image-wrapper {
    flex: 1;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--blue-panel-light);
    border-radius: 4px;
  }

  .cc-film-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(80%);
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), filter 0.5s ease;
  }

  .cc-film-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 59, 153, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--yellow);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .cc-film-info {
    margin-top: 20px;
  }

  .cc-film-title {
    font-family: var(--font-ui);
    font-size: 24px;
    color: var(--blue-lightest);
    text-transform: uppercase;
    margin: 0 0 10px 0;
    letter-spacing: 1px;
  }

  .cc-film-desc {
    font-family: var(--font-body);
    color: var(--blue-panel-light);
    font-size: 16px;
    margin: 0;
  }

  /* HOVER EFFECTS */
  .cc-film-card:hover .cc-film-image {
    transform: scale(1.05);
    filter: grayscale(0%);
  }
  .cc-film-card:hover .cc-film-overlay {
    opacity: 1;
  }
</style>
