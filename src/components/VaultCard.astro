---
interface Props {
  id: string;
  title: string;
  director: string;
  year: number;
  image: string;
  i?: number;
  group?: string;
  isHome?: boolean;
}

const { id, title, director, year, image, i = 0, group = '', isHome = false } = Astro.props;
---
<div 
  class={`cc-vault-card cc-card ${isHome ? 'cc-vault-card--home' : ''}`} 
  data-group={group} 
  data-href={`/films/${id}`} 
  style={`--i: ${i}`}
  tabindex="0"
  role="button"
>
  <div class="cc-vault-card__inner">
    <img src={image} alt={title} class="cc-vault-card__poster" />
    <div class="cc-vault-card__overlay">
      <div class="cc-vault-card__scanline"></div>
      <div class="cc-vault-card__meta">
        <span class="cc-vault-card__year">{year}</span>
        <h3 class="cc-vault-card__title">{title}</h3>
        <span class="cc-vault-card__dir">DIR: {director}</span>
      </div>
    </div>
  </div>
</div>

<style>
  .cc-vault-card {
    position: relative;
    aspect-ratio: 2/3;
    display: block;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), z-index 0s;
    z-index: 1;
    animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
    transform: translateY(20px) rotateX(10deg);
    animation-delay: calc(var(--i) * 0.1s);
    text-decoration: none;
    /* Reset .cc-card base styles that conflict */
    background: none !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  
  .cc-vault-card--home {
    height: 100%;
    aspect-ratio: auto;
    width: 150px;
    flex: 0 0 150px;
  }
  
  .cc-vault-card::before, .cc-vault-card::after, .cc-vault-card .cc-card__corner-br {
    display: none !important;
  }

  @keyframes fade-in-up {
    to {
      opacity: 1;
      transform: translateY(0) rotateX(0);
    }
  }

  .cc-vault-card:hover,
  .cc-vault-card.is-selected {
    transform: translateY(-10px) scale(1.05) rotateX(0) rotateY(0) !important;
    z-index: 10;
  }
  
  .cc-vault-card--home:hover,
  .cc-vault-card--home.is-selected {
    transform: translateY(0) scale(1.02) rotateX(0) rotateY(0) !important;
  }

  .cc-vault-card__inner {
    position: relative;
    width: 100%;
    height: 100%;
    border: 2px solid var(--navy-deep);
    box-shadow: 
      inset 0 0 0 1px var(--blue-panel-light),
      0 10px 30px rgba(0, 10, 40, 0.8);
    overflow: hidden;
    background: var(--navy-deep);
    transition: all 0.3s ease;
  }

  .cc-vault-card:hover .cc-vault-card__inner,
  .cc-vault-card.is-selected .cc-vault-card__inner {
    border-color: var(--yellow);
    box-shadow: 
      inset 0 0 0 1px var(--yellow),
      0 20px 40px rgba(0, 10, 40, 0.9),
      0 0 20px rgba(255, 240, 0, 0.2);
  }

  .cc-vault-card__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
    transition: filter 0.4s;
  }

  .cc-vault-card:hover .cc-vault-card__poster,
  .cc-vault-card.is-selected .cc-vault-card__poster {
    filter: grayscale(0%) contrast(1);
  }

  .cc-vault-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,59,153, 0.9) 0%, rgba(0,59,153, 0.2) 50%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
  }

  .cc-vault-card:hover .cc-vault-card__overlay,
  .cc-vault-card.is-selected .cc-vault-card__overlay {
    opacity: 1;
  }

  .cc-vault-card__scanline {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(255, 240, 0, 0.5);
    box-shadow: 0 0 10px var(--yellow);
    opacity: 0;
  }

  .cc-vault-card:hover .cc-vault-card__scanline,
  .cc-vault-card.is-selected .cc-vault-card__scanline {
    animation: scan 2s infinite linear;
    opacity: 1;
  }

  @keyframes scan {
    0% { top: 0; }
    100% { top: 100%; }
  }

  .cc-vault-card__meta {
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cc-vault-card:hover .cc-vault-card__meta,
  .cc-vault-card.is-selected .cc-vault-card__meta {
    transform: translateY(0);
  }

  .cc-vault-card__year {
    font-family: var(--font-ui);
    color: var(--blue-lightest);
    font-size: 10px;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 2px;
  }

  .cc-vault-card__title {
    font-family: var(--font-ui);
    color: var(--yellow);
    font-size: 16px;
    text-transform: uppercase;
    margin: 0 0 2px 0;
    line-height: 1.1;
  }

  .cc-vault-card__dir {
    font-family: var(--font-ui);
    color: var(--blue-panel-light);
    font-size: 9px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
</style>
