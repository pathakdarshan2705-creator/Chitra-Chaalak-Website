---
---
<div id="holographic-canvas" class="cc-holographic-canvas" aria-hidden="true">
  <div class="cc-holographic-canvas__backdrop" id="holographic-backdrop"></div>
  <div class="cc-holographic-canvas__content-wrapper" id="holographic-wrapper">
    <button class="cc-holographic-canvas__close" id="holographic-close" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="cc-holographic-canvas__meta" id="holographic-meta">
      <div class="cc-holographic-canvas__date" id="holographic-date"></div>
      <div class="cc-holographic-canvas__location" id="holographic-location"></div>
    </div>
    <h1 class="cc-holographic-canvas__title" id="holographic-title"></h1>
    <div class="cc-holographic-canvas__body" id="holographic-body"></div>
  </div>
</div>

<style>
  .cc-holographic-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .cc-holographic-canvas.is-active {
    opacity: 1;
    pointer-events: all;
  }

  .cc-holographic-canvas__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 59, 153, 0.7); /* navy-deep with opacity */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .cc-holographic-canvas__content-wrapper {
    position: relative;
    width: 90%;
    max-width: 800px;
    max-height: 85vh;
    background: var(--navy-deep);
    border: 1px solid var(--blue-panel-light);
    box-shadow: inset 0 0 0 1px var(--blue-panel-light), 0 10px 40px rgba(0, 10, 40, 0.8);
    padding: 40px;
    overflow-y: auto;
    transform: scale(0.9) translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s;
    opacity: 0;
    color: var(--blue-lightest);
  }
  
  .cc-holographic-canvas.is-active .cc-holographic-canvas__content-wrapper {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .cc-holographic-canvas__close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--blue-panel-light);
    border: none;
    color: var(--navy-deep);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  
  .cc-holographic-canvas__close:hover {
    background: var(--yellow);
    transform: rotate(90deg);
  }

  .cc-holographic-canvas__meta {
    display: flex;
    gap: 16px;
    font-size: 0.9rem;
    color: var(--blue-panel-light);
    margin-bottom: 12px;
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .cc-holographic-canvas__location {
    color: var(--blue-panel-light);
  }

  .cc-holographic-canvas__title {
    font-size: 2.5rem;
    margin: 0 0 24px 0;
    color: var(--yellow);
    font-family: var(--font-ui);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cc-holographic-canvas__body {
    line-height: 1.7;
    font-size: 1.1rem;
    font-family: var(--font-body);
  }
  
  .cc-holographic-canvas__body h1, 
  .cc-holographic-canvas__body h2, 
  .cc-holographic-canvas__body h3 {
    color: var(--yellow);
    font-family: var(--font-ui);
    text-transform: uppercase;
    margin-top: 2rem;
  }
  
  .cc-holographic-canvas__body a {
    color: var(--yellow);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 240, 0, 0.3);
    transition: border-color 0.2s;
  }
  .cc-holographic-canvas__body a:hover {
    border-color: var(--yellow);
  }
  
  .cc-holographic-canvas__body pre {
    background: rgba(0, 10, 40, 0.5);
    padding: 16px;
    border-radius: 4px;
    border: 1px solid var(--blue-panel-light);
    overflow-x: auto;
  }
  
  .cc-holographic-canvas__body blockquote {
    border-left: 4px solid var(--yellow);
    margin: 1.5em 0;
    padding-left: 1em;
    color: var(--blue-panel-light);
    font-style: italic;
  }

  /* Custom Scrollbar for Modal */
  .cc-holographic-canvas__content-wrapper::-webkit-scrollbar {
    width: 8px;
  }
  .cc-holographic-canvas__content-wrapper::-webkit-scrollbar-track {
    background: transparent;
  }
  .cc-holographic-canvas__content-wrapper::-webkit-scrollbar-thumb {
    background: var(--blue-panel-light);
    border-radius: 4px;
  }
  
  @media (max-width: 768px) {
    .cc-holographic-canvas__content-wrapper {
      width: 95%;
      padding: 24px;
      padding-top: 60px;
    }
  }
</style>
