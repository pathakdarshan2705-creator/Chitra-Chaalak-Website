---
// Camera's AF sort of interaction that whereever we hover the mouse, frame will slightly come into focus as it happens in actual camera viewfinder. This is a purely visual effect, not a functional one.
---
<div class="cc-focus-frame" id="cc-focus-frame" aria-hidden="true">
  <span class="cc-focus-frame__corner cc-focus-frame__corner--tl"></span>
  <span class="cc-focus-frame__corner cc-focus-frame__corner--tr"></span>
  <span class="cc-focus-frame__corner cc-focus-frame__corner--bl"></span>
  <span class="cc-focus-frame__corner cc-focus-frame__corner--br"></span>
</div>

<style>
  .cc-focus-frame {
    position: fixed;
    top: 0; left: 0;
    width: 40px; height: 40px;
    pointer-events: none;
    z-index: 2500;
    opacity: 0;
    transition:
      transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1),
      width 0.22s cubic-bezier(0.34, 1.4, 0.64, 1),
      height 0.22s cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity 0.15s ease-out;
  }
  .cc-focus-frame.is-active { opacity: 1; }

  .cc-focus-frame__corner {
    position: absolute;
    width: 11px; height: 11px;
    border: 1.5px solid var(--yellow);
  }
  .cc-focus-frame__corner--tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
  .cc-focus-frame__corner--tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
  .cc-focus-frame__corner--bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
  .cc-focus-frame__corner--br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

  /* a quick "acquired focus" flash the instant it locks on */
  .cc-focus-frame.is-locking .cc-focus-frame__corner {
    animation: cc-focus-lock 0.25s steps(3) 1;
  }
  @keyframes cc-focus-lock {
    0%   { border-color: #ffffff; }
    100% { border-color: var(--yellow); }
  }

  /* Click lock-tighten: brackets snap ~2px inward before settling */
  .cc-focus-frame.is-tightening .cc-focus-frame__corner--tl {
    animation: cc-tighten-tl 0.22s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }
  .cc-focus-frame.is-tightening .cc-focus-frame__corner--tr {
    animation: cc-tighten-tr 0.22s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }
  .cc-focus-frame.is-tightening .cc-focus-frame__corner--bl {
    animation: cc-tighten-bl 0.22s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }
  .cc-focus-frame.is-tightening .cc-focus-frame__corner--br {
    animation: cc-tighten-br 0.22s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }

  @keyframes cc-tighten-tl {
    0%   { transform: translate(0, 0); }
    45%  { transform: translate(2px, 2px); border-color: #ffffff; }
    100% { transform: translate(0, 0); border-color: var(--yellow); }
  }
  @keyframes cc-tighten-tr {
    0%   { transform: translate(0, 0); }
    45%  { transform: translate(-2px, 2px); border-color: #ffffff; }
    100% { transform: translate(0, 0); border-color: var(--yellow); }
  }
  @keyframes cc-tighten-bl {
    0%   { transform: translate(0, 0); }
    45%  { transform: translate(2px, -2px); border-color: #ffffff; }
    100% { transform: translate(0, 0); border-color: var(--yellow); }
  }
  @keyframes cc-tighten-br {
    0%   { transform: translate(0, 0); }
    45%  { transform: translate(-2px, -2px); border-color: #ffffff; }
    100% { transform: translate(0, 0); border-color: var(--yellow); }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc-focus-frame.is-tightening .cc-focus-frame__corner {
      animation: none !important;
    }
  }
</style>

<script>
  // @ts-nocheck
  if (!window.__ccFocusFrameInit) {
    window.__ccFocusFrameInit = true;

    const frame = document.getElementById('cc-focus-frame');
    if (frame) {
      const TARGETS = '.cc-card, .cc-btn, .cc-icon-btn, .cc-panel__viewall, .cc-contact-panel__list a';
      let current = null;

      function place(el) {
        const r = el.getBoundingClientRect();
        const pad = 4;
        frame.style.width = `${r.width + pad * 2}px`;
        frame.style.height = `${r.height + pad * 2}px`;
        frame.style.transform = `translate(${r.left - pad}px, ${r.top - pad}px)`;
        frame.classList.add('is-active', 'is-locking');
        setTimeout(() => frame.classList.remove('is-locking'), 200);
      }

      function triggerTighten() {
        if (!frame.classList.contains('is-active')) return;
        frame.classList.remove('is-tightening');
        void frame.offsetWidth;
        frame.classList.add('is-tightening');
        setTimeout(() => frame.classList.remove('is-tightening'), 200);
      }

      // Show momentarily on mouse click for visual feedback, then dismiss
      document.addEventListener('click', (e) => {
        const target = e.target.closest(TARGETS);
        if (target) {
          current = target;
          place(target);
          triggerTighten();
          setTimeout(() => {
            frame.classList.remove('is-active');
            current = null;
          }, 200);
        }
      });

      // Show on keyboard selection
      document.addEventListener('cc:card-selected', ((e) => {
        if (e.detail?.card) {
          current = e.detail.card;
          place(e.detail.card);
          triggerTighten();
        }
      }));

      // Dismiss frame on general mouse click/movement outside
      document.addEventListener('mousedown', (e) => {
        if (!e.target.closest(TARGETS)) {
          frame.classList.remove('is-active');
          current = null;
        }
      });

      document.addEventListener('scroll', () => {
        if (current && frame.classList.contains('is-active')) place(current);
      }, true);
    }
  }
</script>