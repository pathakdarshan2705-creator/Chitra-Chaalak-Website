---
// Tried to add a remote control feature to the site, where pressing 1-6 on the keyboard would scroll to different sections of the site. This is a fun little easter egg for users who want to navigate the site like a TV remote. Although still figuring out how to do

---
<script>
  console.log("✅ Remote Control Loaded");
  if (!window.__ccRemoteControlInit) {
  window.__ccRemoteControlInit = true;

  const KEYMAP = {
      '1': 'updates',
      '2': 'films',
      '3': 'blog',
      '4': 'tour',
      '5': 'collections',
      '6': 'portfolio',
    };

    document.addEventListener('keydown', (e) => {
      const active = document.activeElement;
      if (active && ['INPUT', 'TEXTAREA'].includes(active.tagName)) return;

      const group = KEYMAP[e.key];
      if (!group) return;

      const cards = Array.from(
  document.querySelectorAll(`.cc-card[data-group="${group}"]`)
);

      let current = cards.find((c) => c.classList.contains('is-selected'));
      if (!current) {
        current = cards[0];
        current.classList.add('is-selected');
      }
      current.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
    });
  }
</script>