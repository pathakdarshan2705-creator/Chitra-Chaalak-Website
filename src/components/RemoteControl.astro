---
// src/components/RemoteControl.astro
//
// Number keys 1-6 jump straight to a section. Arrow keys move the
// selection within whichever section you were last in. Enter opens
// whatever's currently selected. A short busy-lock after each move
// prevents rapid key-repeat from firing overlapping scroll animations,
// which was the "getting selected but not smooth" issue.
---
<script>
  // @ts-nocheck
if (!window.__ccRemoteControlInit) {
    window.__ccRemoteControlInit = true;

    const KEYMAP: Record<string, string> = {
      '1': 'updates', '2': 'films', '3': 'blog',
      '4': 'tour', '5': 'collections', '6': 'portfolio',
    };

    const SECTION_URLS: Record<string, string> = {
      updates: '/updates',
      films: '/films',
      blog: '/blog',
      tour: '/tour',
      collections: '/collections',
      portfolio: '/portfolio',
    };

    let lastGroup: string | null = null;
    let busy = false;

    // mouse clicks (handled by CardInteractions.astro) also count as
    // "last touched section" so arrow keys work immediately after a
    // mouse selection, not just after a keyboard one
    document.addEventListener('cc:card-selected', ((e: CustomEvent) => {
      if (e.detail?.group) {
        lastGroup = e.detail.group;
      }
    }) as EventListener);

    function cardsIn(group: string): HTMLElement[] {
      return Array.from(document.querySelectorAll(`.cc-card[data-group="${group}"]`));
    }

    function select(group: string, card: HTMLElement) {
      cardsIn(group).forEach((c) => c.classList.remove('is-selected'));
      card.classList.add('is-selected');
      card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      lastGroup = group;
      document.dispatchEvent(new CustomEvent('cc:card-selected', { detail: { group, card } }));
    }

    document.addEventListener('keydown', (e) => {
      // 1. Mobile check: physical keyboard shortcuts are disabled on mobile viewports
      if (window.innerWidth <= 768 || window.matchMedia('(max-width: 768px)').matches) return;

      // 2. Form/input check: don't intercept while user is typing in any text or editable field
      const active = document.activeElement;
      if (active && (['INPUT', 'TEXTAREA', 'SELECT'].includes(active.tagName) || (active as HTMLElement).isContentEditable)) return;

      // 3. Modifier keys check: don't conflict with browser shortcuts (Ctrl+R, Alt+Left, Cmd+W, etc.)
      if (e.ctrlKey || e.metaKey || e.altKey) return;

      // Number keys 1-6: jump straight to a section
      const numberGroup = KEYMAP[e.key];
      if (numberGroup && !e.shiftKey) {
        if (busy) return;
        const cards = cardsIn(numberGroup);
        if (cards.length > 0) {
          e.preventDefault();
          busy = true;
          const current = cards.find((c) => c.classList.contains('is-selected'));
          // Dispatch in-page channel wipe transition
          document.dispatchEvent(new CustomEvent('cc:channel-jump', { detail: { inPage: true } }));
          // Switch selection midway through the wipe covering the screen
          setTimeout(() => {
            select(numberGroup, current ?? cards[0]);
          }, 200);
          // Unlock after wipe has fully revealed
          setTimeout(() => { busy = false; }, 600);
          return;
        } else if (SECTION_URLS[numberGroup] && window.location.pathname !== SECTION_URLS[numberGroup]) {
          // Section not present on current page (e.g. on /about), navigate via channel wipe
          e.preventDefault();
          busy = true;
          document.dispatchEvent(new CustomEvent('cc:channel-jump'));
          setTimeout(() => { window.location.href = SECTION_URLS[numberGroup]; }, 320);
          return;
        }
      }

      // Enter: open whatever's currently selected in the last-used group
      if (e.key === 'Enter') {
        const group = lastGroup ?? Object.values(KEYMAP).find((g) => cardsIn(g).length);
        if (!group) return;
        const cards = cardsIn(group);
        const sel = cards.find((c) => c.classList.contains('is-selected')) ?? cards[0];
        const href = sel?.dataset.href;
        if (href && href !== '#') {
          e.preventDefault();
          busy = true;
          document.dispatchEvent(new CustomEvent('cc:channel-jump'));
          setTimeout(() => { window.location.href = href; }, 320);
        }
        return;
      }

      // Arrow keys: move selection within whichever section was last touched
      const isNext = e.key === 'ArrowDown' || e.key === 'ArrowRight';
      const isPrev = e.key === 'ArrowUp' || e.key === 'ArrowLeft';
      if (!isNext && !isPrev) return;
      if (busy) return;

      const group = lastGroup ?? Object.values(KEYMAP).find((g) => cardsIn(g).length);
      if (!group) return;
      const cards = cardsIn(group);
      if (!cards.length) return;

      e.preventDefault();

      const current = cards.find((c) => c.classList.contains('is-selected'));
      const idx = current ? cards.indexOf(current) : -1;
      let next = idx + (isNext ? 1 : -1);
      if (next < 0) next = cards.length - 1;
      if (next >= cards.length) next = 0;

      busy = true;
      select(group, cards[next]);
      setTimeout(() => { busy = false; }, 200);
    });
  }
</script>