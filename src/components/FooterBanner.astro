---
// src/components/FooterBanner.astro
// Broadcast ticker — matches the double-border/bevel language used
// everywhere else, plus a live signal-bar meter (same visual family
// as UpdateEntryCard) so it reads as part of the same system.
---
<div class="cc-footer">
  <span class="cc-footer__corner cc-footer__corner--tl"></span>
  <span class="cc-footer__corner cc-footer__corner--tr"></span>

  <a href="/" class="cc-footer__link cc-footer__segment cc-footer__home">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    HOME
  </a>
  <div class="cc-footer__divider"></div>

  <div class="cc-footer__segment">
    <span class="cc-footer__dot"></span>
    <span id="cc-footer-date">--</span>
  </div>
  <div class="cc-footer__divider"></div>
  <div class="cc-footer__segment">
    <span id="cc-footer-time">--:--:--</span>
  </div>
  
  <a href="/filter" class="cc-footer__link cc-footer__link--right">
    <span>FILTER</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cc-footer__link-icon">
      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
    </svg>
  </a>
</div>

<style>
  .cc-footer{
    position: relative;
    flex-shrink:0;
    height:var(--footer-height);
    background:var(--navy-deep);
    color:var(--blue-lightest);
    font-family:var(--font-ui);
    font-size:clamp(11px, 0.9vw, 13px);
    font-weight:600;
    letter-spacing:1px;
    display:flex;
    align-items:center;
    gap:18px;
    padding:0 24px;
    border-top: 2px solid var(--blue-panel-light);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.1),
      0 -4px 20px rgba(0, 10, 40, 0.5);
  }

  .cc-footer__corner{
    position:absolute;
    width:9px; height:9px;
    opacity:0.7;
    pointer-events:none;
  }
  .cc-footer__corner--tl{ top:3px; left:3px; border-top:2px solid var(--yellow); border-left:2px solid var(--yellow); }
  .cc-footer__corner--tr{ top:3px; right:3px; border-top:2px solid var(--yellow); border-right:2px solid var(--yellow); }

  .cc-footer__segment{
    display:flex;
    align-items:center;
    gap:7px;
  }



  .cc-footer__link{
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .cc-footer__link:hover {
    color: var(--yellow);
  }
  
  .cc-footer__link--right {
    margin-left: auto;
    background: var(--blue-card);
    color: var(--yellow);
    padding: 6px 18px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    border: 1px solid var(--blue-panel-light);
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
  }
  
  .cc-footer__link--right:hover {
    background: var(--yellow);
    color: var(--navy-deep);
    border-color: var(--yellow);
    box-shadow: 0 0 15px rgba(255, 240, 0, 0.4);
    transform: translateY(-2px);
  }
  
  .cc-footer__link-icon {
    transition: transform 0.2s ease;
  }
  
  .cc-footer__link--right:hover .cc-footer__link-icon {
    transform: translateX(3px);
  }

  .cc-footer__divider{
    width:1px;
    height:16px;
    background:var(--blue-column);
    flex-shrink:0;
  }

  .cc-footer__dot{
    width:6px; height:6px;
    background:var(--yellow);
    border-radius:50%;
    animation:cc-pulse-dot 1.5s ease-in-out infinite;
  }

  @keyframes cc-pulse-dot{
    0%,100%{ opacity:1; }
    50%{ opacity:0.25; }
  }

  .cc-footer__bars{
    display:flex;
    gap:2px;
  }

  .cc-footer__bar{
    width:3px; height:10px;
    background:var(--yellow);
    opacity:0.85;
    animation:cc-footer-bar-flicker 2s ease-in-out infinite;
  }

  @keyframes cc-footer-bar-flicker{
    0%,100%{ opacity:0.85; }
    50%{ opacity:0.3; }
  }

  @media (max-width: 768px) {
    .cc-footer {
      height: 48px;
      padding: 0 16px;
      gap: 12px;
      border-top: 1px solid var(--blue-panel-light);
    }
    .cc-footer__corner { display: none; }
    .cc-footer__home { font-size: 0; padding-right: 0; } 
    .cc-footer__home svg { margin-right: 0 !important; width: 22px; height: 22px; }
    #cc-footer-date { display: inline-block; font-size: 11px; }
    .cc-footer__dot { display: inline-block; }
    #cc-footer-time { font-size: 11px; font-weight: 700; color: var(--yellow); }
    .cc-footer__link--right span { display: inline-block; font-size: 11px; letter-spacing: 1px; }
    .cc-footer__link--right { padding: 6px 12px; }
  }
</style>

<script>
  // @ts-nocheck
function ccUpdateFooter(){
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();
    const timeStr = now.toLocaleTimeString('en-GB', { hour12:false });
    const dateEl = document.getElementById('cc-footer-date');
    const timeEl = document.getElementById('cc-footer-time');
    if (dateEl) dateEl.textContent = dateStr;
    if (timeEl) timeEl.textContent = timeStr;
  }
  ccUpdateFooter();
  setInterval(ccUpdateFooter, 1000);
</script>