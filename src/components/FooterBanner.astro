---
// src/components/FooterBanner.astro
// Broadcast ticker — matches the double-border/bevel language used
// everywhere else, plus a live signal-bar meter (same visual family
// as UpdateEntryCard) so it reads as part of the same system.
---
<div class="cc-footer">
  <span class="cc-footer__corner cc-footer__corner--tl"></span>
  <span class="cc-footer__corner cc-footer__corner--tr"></span>

  <div class="cc-footer__segment">
    <span class="cc-footer__dot"></span>
    <span id="cc-footer-date">--</span>
  </div>
  <div class="cc-footer__divider"></div>
  <div class="cc-footer__segment">
    <span id="cc-footer-time">--:--:--</span>
  </div>
  
  <a href="/filter" class="cc-footer__link cc-footer__link--center">
    <span>FILTER STUDIO</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cc-footer__link-icon">
      <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <div class="cc-footer__segment cc-footer__segment--steps">
    <span>STEPS</span>
    <span class="cc-footer__bars" aria-hidden="true">
      {Array.from({ length: 8 }).map((_, i) => (
        <span class="cc-footer__bar" style={`animation-delay:${i * 0.09}s`}></span>
      ))}
    </span>
    <span id="cc-footer-steps">----</span>
  </div>
</div>

<style>
  .cc-footer{
    position: relative;
    flex-shrink:0;
    height:var(--footer-height);
    background:var(--blue-lightest);
    color:var(--navy-deep);
    font-family:var(--font-ui);
    font-size:clamp(11px, 0.9vw, 13px);
    font-weight:600;
    letter-spacing:1px;
    display:flex;
    align-items:center;
    gap:18px;
    padding:0 24px;
    border-top: 2px solid var(--navy-deep);
    box-shadow:
      inset 0 2px 0 var(--yellow),
      inset 0 0 0 1px rgba(0,10,40,0.15);
  }

  .cc-footer__corner{
    position:absolute;
    width:9px; height:9px;
    opacity:0.7;
    pointer-events:none;
  }
  .cc-footer__corner--tl{ top:3px; left:3px; border-top:2px solid var(--navy-deep); border-left:2px solid var(--navy-deep); }
  .cc-footer__corner--tr{ top:3px; right:3px; border-top:2px solid var(--navy-deep); border-right:2px solid var(--navy-deep); }

  .cc-footer__segment{
    display:flex;
    align-items:center;
    gap:7px;
  }

  .cc-footer__segment--steps{
    margin-left:auto;
  }

  .cc-footer__link{
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .cc-footer__link--center {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 10, 40, 0.4);
    color: var(--blue-lightest);
    padding: 6px 18px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    border: 1px solid var(--blue-panel-light);
    box-shadow: 0 0 10px rgba(103, 200, 255, 0.2);
  }
  
  .cc-footer__link--center:hover{
    background: var(--blue-card-hover);
    color: #fff;
    border-color: var(--yellow);
    box-shadow: 0 0 15px rgba(255, 240, 0, 0.4);
    transform: translateX(-50%) translateY(-2px);
  }
  
  .cc-footer__link-icon {
    transition: transform 0.2s ease;
  }
  
  .cc-footer__link--center:hover .cc-footer__link-icon {
    transform: translateX(3px);
  }

  .cc-footer__divider{
    width:1px;
    height:16px;
    background:rgba(0,10,40,0.25);
    flex-shrink:0;
  }

  .cc-footer__dot{
    width:6px; height:6px;
    background:var(--navy-deep);
    border-radius:50%;
    animation:cc-pulse-dot 1.5s ease-in-out infinite;
  }

  @keyframes cc-pulse-dot{
    0%,100%{ opacity:1; }
    50%{ opacity:0.25; }
  }

  .cc-footer__bars{
    display:flex;
    gap:2px;
  }

  .cc-footer__bar{
    width:3px; height:10px;
    background:var(--navy-deep);
    opacity:0.85;
    animation:cc-footer-bar-flicker 2s ease-in-out infinite;
  }

  @keyframes cc-footer-bar-flicker{
    0%,100%{ opacity:0.85; }
    50%{ opacity:0.3; }
  }

  @media (max-width: 768px){
    .cc-footer{ gap:10px; padding:0 14px; font-size:10px; }
    .cc-footer__bars{ display:none; }
  }
</style>

<script>
  function ccUpdateFooter(){
    const now = new Date();
    const dateStr = now.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();
    const timeStr = now.toLocaleTimeString('en-GB', { hour12:false });
    const dateEl = document.getElementById('cc-footer-date');
    const timeEl = document.getElementById('cc-footer-time');
    if (dateEl) dateEl.textContent = dateStr;
    if (timeEl) timeEl.textContent = timeStr;
    // steps stays placeholder until the Phase 4 phone-sync endpoint is wired in
  }
  ccUpdateFooter();
  setInterval(ccUpdateFooter, 1000);
</script>