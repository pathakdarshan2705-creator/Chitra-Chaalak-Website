---
// src/components/CassetteCard.astro
import Icon from './Icons.astro';
interface Props { href: string; label: string; group?: string; }
const { href, label, group } = Astro.props;
---
<div
  class="cc-card cc-cassette"
  data-href={href}
  data-group={group ?? ''}
  data-title={label}
  data-meta="Portfolio"
  data-image=""
  tabindex="0"
  role="button"
>
  <span class="cc-cassette__dots"><Icon name="dots" size={12} /></span>
  <div class="cc-cassette__body">
    <span class="cc-cassette__reel"></span>
    <span class="cc-cassette__tape"></span>
    <span class="cc-cassette__reel"></span>
  </div>
  <div class="cc-cassette__label">{label}</div>
  <span class="cc-card__corner-br"></span>
</div>
<style>
  .cc-cassette { flex-direction:column; gap:0; padding:8px 10px; align-items:stretch; }
  .cc-cassette__dots { color:var(--blue-lightest); opacity:0.6; margin-bottom:5px; display:block; }
  .cc-cassette__body {
    display:flex; align-items:center; justify-content:center;
    background:var(--blue-column);
    padding:8px 0; margin-bottom:5px;
    box-shadow:inset 0 0 0 1px rgba(0,10,40,0.3);
  }
  .cc-cassette__reel {
    width:clamp(12px,1.4vw,18px);
    height:clamp(12px,1.4vw,18px);
    border-radius:50%;
    border:3px solid var(--blue-lightest);
    background:var(--navy-deep);
  }
  .cc-cassette__tape {
    width:clamp(20px,2.5vw,32px);
    height:4px;
    background:var(--blue-lightest);
    margin:0 -1px;
  }
  .cc-cassette__label {
    font-family:var(--font-ui);
    font-weight:600;
    font-size:clamp(9px,0.8vw,11px);
    letter-spacing:0.5px;
    text-transform:uppercase;
    color:var(--blue-lightest);
  }
  .cc-cassette.is-selected { background:var(--yellow); }
  .cc-cassette.is-selected .cc-cassette__label { color:var(--navy-deep); }
  .cc-cassette.is-selected .cc-cassette__body { background:var(--blue-card-hover); }
</style>