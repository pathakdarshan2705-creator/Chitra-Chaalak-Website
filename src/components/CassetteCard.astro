---
// Portfolio section with cassette style cards in it

import Icon from './Icons.astro';
interface Props { href: string; label: string; group?: string; }
const { href, label, group } = Astro.props;
---
<div
  class="cc-card cc-cassette"
  data-href={href}
  data-group={group ?? ''}
  data-title={label}
  data-meta="Portfolio"
  data-image=""
  tabindex="0"
  role="button"
  aria-label={label}
>
  <span class="cc-cassette__dots"><Icon name="dots" size={12} /></span>
  <div class="cc-cassette__body">
    <span class="cc-cassette__reel"></span>
    <span class="cc-cassette__tape"></span>
    <span class="cc-cassette__reel"></span>
  </div>
  <div class="cc-cassette__title">{label}</div>
  <span class="cc-card__corner-br"></span>
</div>

<style>
  .cc-cassette {
    position: relative;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    justify-content: space-between !important;
    gap: 0 !important;
    padding: 7px 12px !important;
    background: var(--blue-card);
    border: 2px solid var(--navy-deep);
    box-shadow:
      inset 0 0 0 2px var(--blue-panel-light),
      inset 0 0 0 3px var(--navy-deep),
      inset 1px 1px 0 rgba(255,255,255,0.15),
      inset -1px -1px 0 rgba(0,10,40,0.35);
    flex: 1 1 0;
    min-height: 56px;
    max-height: 76px;
    width: 100% !important;
    box-sizing: border-box !important;
    cursor: pointer;
    outline: none;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .cc-cassette::before {
    content: "";
    position: absolute;
    top: 3px; left: 3px;
    width: 6px; height: 6px;
    border-top: 2px solid var(--blue-panel-light);
    border-left: 2px solid var(--blue-panel-light);
    opacity: 0.8;
    pointer-events: none;
    z-index: 1;
  }

  .cc-card__corner-br {
    position: absolute;
    bottom: 3px; right: 3px;
    width: 6px; height: 6px;
    border-bottom: 2px solid var(--blue-panel-light);
    border-right: 2px solid var(--blue-panel-light);
    opacity: 0.8;
    pointer-events: none;
    z-index: 1;
  }

  .cc-cassette__dots {
    color: var(--blue-lightest);
    opacity: 0.6;
    display: block;
    line-height: 1;
    margin-bottom: 2px;
    flex-shrink: 0;
  }

  .cc-cassette__body {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: var(--blue-column);
    padding: 4px 0;
    margin: 2px 0 4px 0;
    box-shadow: inset 0 0 0 1px rgba(0,10,40,0.35);
    border-radius: 2px;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .cc-cassette__reel {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid var(--blue-lightest);
    background: var(--navy-deep);
    flex-shrink: 0;
  }

  .cc-cassette__tape {
    width: clamp(24px, 2.5vw, 36px);
    height: 3px;
    background: var(--blue-lightest);
    margin: 0 -1px;
    flex-shrink: 0;
  }

  .cc-cassette__title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(9px, 0.72vw, 10.5px);
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: var(--blue-lightest);
    text-align: center;
    width: 100%;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    margin: 0;
    padding: 0 6px;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  /* Hover & Selected states */
  .cc-cassette:hover,
  .cc-cassette:focus-visible {
    border-color: var(--yellow);
    box-shadow:
      inset 0 0 0 2px var(--yellow),
      inset 0 0 0 3px var(--navy-deep),
      0 4px 12px rgba(0,10,40,0.4);
    transform: translateY(-1px);
  }

  .cc-cassette:hover .cc-cassette__title,
  .cc-cassette:focus-visible .cc-cassette__title {
    color: var(--yellow);
  }

  .cc-cassette.is-selected,
  .cc-cassette.is-clicked {
    border-color: var(--yellow);
    box-shadow: 0 0 0 1px var(--yellow), inset 0 0 0 1px var(--yellow);
  }

  .cc-cassette.is-selected .cc-cassette__title,
  .cc-cassette.is-clicked .cc-cassette__title {
    color: var(--yellow);
  }

  .cc-cassette.is-selected::before,
  .cc-cassette.is-selected .cc-card__corner-br,
  .cc-cassette.is-clicked::before,
  .cc-cassette.is-clicked .cc-card__corner-br {
    border-color: var(--yellow);
  }
</style>