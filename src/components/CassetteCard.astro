---
// src/components/CassetteCard.astro
// <CassetteCard href="/portfolio/filmmaking" label="Filmmaking" group="portfolio" />
//
// Uses the same .cc-card contract as Card.astro (data-href/group/title)
// so it participates in the shared click-select / dblclick-open /
// up-down / Enter system unchanged — just a different visual skin.

import Icon from './Icons.astro';

interface Props {
  href: string;
  label: string;
  group?: string;
}
const { href, label, group } = Astro.props;
---
<div
  class="cc-card cc-cassette"
  data-href={href}
  data-group={group ?? ''}
  data-title={label}
  data-meta=""
  data-image=""
  tabindex="0"
  role="button"
  aria-label={`${label}. Click to select, double-click to open.`}
>
  <span class="cc-cassette__dots" aria-hidden="true"><Icon name="dots" size={14} /></span>
  <div class="cc-cassette__body">
    <span class="cc-cassette__reel"></span>
    <span class="cc-cassette__bar"></span>
    <span class="cc-cassette__reel"></span>
  </div>
  <div class="cc-cassette__label">{label}</div>
</div>

<style>
  .cc-cassette{
    display:block;
    padding:10px;
  }

  .cc-cassette__dots{
    display:block;
    color:var(--blue-lightest);
    opacity:0.7;
    margin-bottom:6px;
  }

  .cc-cassette__body{
    display:flex;
    align-items:center;
    justify-content:center;
    background:var(--blue-column);
    padding:8px 0;
    margin-bottom:6px;
    box-shadow:inset 0 0 0 1px rgba(0,10,40,0.3);
  }

  .cc-cassette__reel{
    width:clamp(14px, 1.4vw, 20px);
    height:clamp(14px, 1.4vw, 20px);
    border-radius:50%;
    border:4px solid var(--blue-lightest);
    background:var(--navy-deep);
  }

  .cc-cassette__bar{
    width:clamp(22px, 2.2vw, 32px);
    height:5px;
    background:var(--blue-lightest);
    margin:0 -2px;
  }

  .cc-cassette__label{
    font-family:var(--font-ui);
    font-weight:600;
    font-size:clamp(10px, 0.85vw, 12px);
    letter-spacing:0.5px;
    text-transform:uppercase;
    color:var(--blue-lightest);
  }

  .cc-cassette.is-selected .cc-cassette__label{
    color:var(--navy-deep);
  }
</style>