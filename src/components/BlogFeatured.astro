---
// src/components/BlogFeatured.astro
// The large featured post card at the top of the blog archive.
// Static markup for the DEFAULT (today's/latest) post — swapped live
// by JS when a date is picked in BlogCalendar, using a JSON map of
// all posts embedded on the page so no page reload is needed.
interface Props {
  title: string;
  date: string;
  topic: string;
  excerpt: string;
  imageSrc: string;
  imageAlt?: string;
  href: string;
}
import { Image } from 'astro:assets';
const { title, date, topic, excerpt, imageSrc, imageAlt = '', href } = Astro.props;
const isRemote = imageSrc.startsWith('http');
---
<div class="cc-blog-featured" id="cc-blog-featured" tabindex="0" role="button" data-href={href}>
  <div class="cc-blog-featured__img">
    {isRemote ? (
      <Image id="cc-blog-featured-img" src={imageSrc} alt={imageAlt} inferSize={true} />
    ) : (
      <img id="cc-blog-featured-img" src={imageSrc} alt={imageAlt} />
    )}
  </div>
  <div class="cc-blog-featured__body">
    <div class="cc-blog-featured__title" id="cc-blog-featured-title">{title}</div>
    <div class="cc-blog-featured__meta">
      <span id="cc-blog-featured-date">{date}</span>
      <span class="cc-blog-featured__dot">•</span>
      <span id="cc-blog-featured-topic">{topic}</span>
    </div>
    <p class="cc-blog-featured__excerpt" id="cc-blog-featured-excerpt">{excerpt}</p>
  </div>
  <a class="cc-blog-featured__enter" id="cc-blog-featured-enter" href={href}>Enter</a>
</div>

<style is:global>
  .cc-blog-featured{
    background: var(--blue-card);
    border: 2px solid var(--navy-deep);
    box-shadow:
      inset 0 0 0 2px var(--blue-panel-light),
      inset 0 0 0 3px var(--navy-deep),
      inset 1px 1px 0 rgba(255,255,255,0.2),
      inset -1px -1px 0 rgba(0,10,40,0.35);
    margin-bottom: 24px;
  }

  .cc-blog-featured__img{
    width: 100%;
    aspect-ratio: 21 / 9;
    max-height: 280px;
    background: var(--navy-deep); /* Changed from blue-panel-light to avoid weird cutouts */
    overflow: hidden;
  }
  .cc-blog-featured__img img{
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease-out;
  }

  .cc-blog-featured__body{
    padding: clamp(16px, 4vw, 24px); /* Fluid padding for mobile to desktop */
  }

  .cc-blog-featured__title{
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.25;
    letter-spacing: 0.5px;
    color: var(--yellow);
    margin-top: 0;
    margin-bottom: 8px;
  }

  .cc-blog-featured__meta{
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.5px;
    color: var(--blue-lightest);
    opacity: 0.75;
    margin-bottom: 12px;
  }
  .cc-blog-featured__dot{ margin: 0 6px; opacity: 0.5; }

  .cc-blog-featured__excerpt{
    font-family: var(--font-body);
    font-size: clamp(14px, 1.1vw, 17px);
    line-height: 1.5;
    color: var(--blue-lightest);
    margin: 0;
  }

  .cc-blog-featured__enter{
    display: block;
    text-align: center;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: var(--navy-deep);
    color: var(--blue-lightest);
    padding: 12px;
    border-top: 1px solid rgba(166,232,255,0.2);
    transition: background 0.1s steps(2), color 0.1s steps(2);
  }
  .cc-blog-featured__enter:hover{
    background: var(--yellow);
    color: var(--navy-deep);
  }
</style>

<script>
  // @ts-nocheck
  if (!window.__ccBlogFeaturedInit) {
    window.__ccBlogFeaturedInit = true;
    document.querySelectorAll('.cc-blog-featured').forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') return;
        const href = (card as HTMLElement).dataset.href;
        if (href) window.location.href = href;
      });
      card.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') {
          const href = (card as HTMLElement).dataset.href;
          if (href) window.location.href = href;
        }
      });
    });
  }
</script>