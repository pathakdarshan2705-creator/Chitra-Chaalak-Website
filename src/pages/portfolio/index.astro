---
import Layout from '../../layouts/Layout.astro';
import SidebarNav from '../../components/SidebarNav.astro';
import Panel from '../../components/Panel.astro';
---
<Layout title="Portfolio">
  <div class="cc-inner-layout">
    <div class="cc-inner-layout__sidebar">
      <SidebarNav
        activePage="portfolio"
        pageTitle="My Work"
        pageDescription="I work across a few different mediums, and I’ve never been very interested in keeping them completely separate.<br><br>This is where I keep the work I’ve made, filmmaking, photography, design and art. Some projects began as college assignments, some came from personal curiosity, some were made with other people, some were made for other people as professional projects, and some simply started because I wanted to see what would happen if I tried.<br><br>There are also a few projects you won’t find here. Some of the work I’ve done is covered by a Non-Disclosure Agreement (NDA), so I can’t share it publicly. I’m happy to talk about those projects and share them privately when appropriate.<br><br>This is not everything I’ve ever made. Just the work I’m able to show, and the work I feel is worth showing."
        controlGroup="portfolio"
        infoTitle="My Work"
        infoMeta="A selection of things I’ve made, shaped, filmed, photographed, and brought into the world."
      />
    </div>

    <div class="cc-inner-content">
      <Panel title="Select Discipline" showControls={false}>
        <a slot="header-extra" href="/uploads/resume.jpg" target="_blank" class="cc-resume-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: -2px;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          My Resume
        </a>
        <div class="cc-portfolio-index" id="portfolio-index-stage">

          <!-- TASK 1: Hanging Pull-Cord Work Light Fixture -->
          <div class="cc-light-fixture" id="portfolio-light-fixture">
            <div class="cc-bulb-socket">
              <div class="cc-bulb-mount"></div>
              <div class="cc-filament-bulb" id="portfolio-bulb" aria-hidden="true">
                <div class="cc-bulb-glass"></div>
                <div class="cc-bulb-filament"></div>
                <div class="cc-bulb-glow"></div>
              </div>
            </div>

            <div class="cc-cord-track" id="cord-track">
              <div class="cc-cord-string" id="cord-string"></div>
              <div
                class="cc-cord-handle"
                id="cord-handle"
                tabindex="0"
                role="button"
                aria-label="Light switch cord. Pull down or press Enter to toggle illumination."
                aria-pressed="false"
              >
                <div class="cc-cord-bead"></div>
                <div class="cc-cord-acorn"></div>
                <div class="cc-cord-pulse-ring" id="cord-pulse-ring" aria-hidden="true"></div>
              </div>

              <!-- Ghost hand guidance -->
              <div class="cc-ghost-hand cc-cord-ghost-hand" id="cord-ghost-hand" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff000" stroke-width="2">
                  <path d="M18 11V6a2 2 0 0 0-4 0v5" />
                  <path d="M14 10V4a2 2 0 0 0-4 0v7" />
                  <path d="M10 10.5V6a2 2 0 0 0-4 0v8" />
                  <path d="M6 14v1a6 6 0 0 0 12 0v-4" />
                </svg>
              </div>
            </div>
          </div>

          <div class="cc-accordion-container" id="portfolio-accordion-container">
            
            <!-- FILMMAKING -->
            <a href="/portfolio/filmmaking" class="cc-accordion-panel" data-section="filmmaking">
              <div class="cc-accordion-bg" style="background-image: url('/uploads/filmmaking.png');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">01</div>
                <h2 class="cc-accordion-title">Filmmaking</h2>
                <div class="cc-accordion-desc">Stories told one frame at a time</div>
              </div>
            </a>

            <!-- PHOTOGRAPHY -->
            <a href="/portfolio/photography" class="cc-accordion-panel" data-section="photography">
              <div class="cc-accordion-bg" style="background-image: url('/uploads/photography.png');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">02</div>
                <h2 class="cc-accordion-title">Photography</h2>
                <div class="cc-accordion-desc">Looking at the world, a little closer</div>
              </div>
            </a>

            <!-- DESIGN -->
            <a href="/portfolio/design" class="cc-accordion-panel" data-section="design">
              <div class="cc-accordion-bg" style="background-image: url('/uploads/design.png');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">03</div>
                <h2 class="cc-accordion-title">Design</h2>
                <div class="cc-accordion-desc">Visual systems and identities</div>
              </div>
            </a>

            <!-- ART -->
            <a href="/portfolio/art" class="cc-accordion-panel" data-section="art">
              <div class="cc-accordion-bg" style="background-image: url('/uploads/art.png');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">04</div>
                <h2 class="cc-accordion-title">Art</h2>
                <div class="cc-accordion-desc">Making something out of a feeling</div>
              </div>
            </a>

          </div>
        </div>
      </Panel>
    </div>
  </div>
</Layout>

<style>
  .cc-portfolio-index {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy-deep);
    /* Baseline: Page is fully legible by default at ~78% brightness/contrast */
    filter: brightness(0.78) contrast(0.95);
    transition: filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Full brightness upgrade when light cord is pulled */
  .cc-portfolio-index.is-lit {
    filter: brightness(1.06) contrast(1.04);
  }

  .cc-portfolio-index.is-lit .cc-accordion-container {
    box-shadow: 0 10px 40px rgba(0, 59, 153, 0.8), 0 0 30px rgba(103, 200, 255, 0.25);
    border-color: var(--yellow);
  }

  .cc-portfolio-index.is-lit .cc-accordion-title {
    color: var(--yellow);
    text-shadow: 0 0 10px rgba(255, 240, 0, 0.5);
  }

  /* Hanging Pull-Cord Work Light Fixture */
  .cc-light-fixture {
    position: absolute;
    top: 0;
    right: 36px;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .cc-bulb-socket {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cc-bulb-mount {
    width: 26px;
    height: 10px;
    background: linear-gradient(180deg, #1a1a1a 0%, #3a3a3a 100%);
    border: 1px solid var(--blue-panel-light);
    border-radius: 2px 2px 0 0;
  }

  .cc-filament-bulb {
    position: relative;
    width: 28px;
    height: 38px;
    border-radius: 50% 50% 35% 35% / 40% 40% 60% 60%;
    background: radial-gradient(circle at 50% 35%, rgba(255, 255, 210, 0.15) 0%, rgba(0, 20, 60, 0.8) 85%);
    border: 1.5px solid rgba(103, 200, 255, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .cc-filament-bulb.is-lit {
    background: radial-gradient(circle at 50% 35%, #ffffff 0%, #fff799 40%, #ffaa00 85%);
    border-color: #ffffff;
    box-shadow: 0 0 24px rgba(255, 240, 0, 0.95), 0 0 50px rgba(255, 220, 0, 0.5);
  }

  .cc-bulb-filament {
    width: 8px;
    height: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    transition: all 0.2s ease;
  }

  .cc-filament-bulb.is-lit .cc-bulb-filament {
    border-color: #ffffff;
    box-shadow: 0 0 8px #ffffff;
  }

  /* Pull-Cord Track */
  .cc-cord-track {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 2px;
    pointer-events: auto;
  }

  .cc-cord-string {
    width: 2px;
    height: 60px;
    background: repeating-linear-gradient(
      180deg,
      #c4a000 0px,
      #c4a000 3px,
      #554400 3px,
      #554400 5px
    );
    box-shadow: 1px 0 2px rgba(0, 0, 0, 0.5);
    transform-origin: top center;
  }

  .cc-cord-handle {
    position: relative;
    width: 24px;
    height: 36px;
    cursor: grab;
    user-select: none;
    touch-action: none;
    outline: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cc-cord-handle:active {
    cursor: grabbing;
  }

  .cc-cord-handle:focus-visible .cc-cord-acorn {
    box-shadow: 0 0 0 2px var(--navy-deep), 0 0 10px var(--yellow);
    border-color: var(--yellow);
  }

  .cc-cord-bead {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d4af37;
    margin-bottom: 2px;
  }

  .cc-cord-acorn {
    width: 14px;
    height: 24px;
    background: linear-gradient(180deg, #d4af37 0%, #8a7018 70%, #59470c 100%);
    border: 1px solid #ffe880;
    border-radius: 3px 3px 8px 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.6);
  }

  .cc-cord-pulse-ring {
    position: absolute;
    inset: -4px;
    border: 2px solid var(--yellow);
    border-radius: 12px;
    pointer-events: none;
    opacity: 0;
  }

  .cc-cord-ghost-hand {
    top: 6px;
    right: -24px;
  }

  .cc-resume-btn {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    background: var(--yellow);
    color: var(--navy-deep);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
    margin-left: auto;
  }
  
  .cc-resume-btn:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .cc-accordion-container {
    display: flex;
    width: 100%;
    height: 85vh; /* Almost full height */
    gap: 8px; /* Space between panels */
    border: 2px solid var(--blue-panel-light);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    background: var(--blue-column);
    padding: 8px;
  }

  .cc-accordion-panel {
    flex: 1;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    transition: flex 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    border: 1px solid var(--navy-deep);
    border-radius: 4px;
    group: accordion;
  }

  .cc-accordion-bg {
    position: absolute;
    inset: -10%; /* Extra space for panning */
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) contrast(1.2);
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1), filter 0.6s ease;
  }

  .cc-accordion-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--navy-deep) 0%, rgba(0, 59, 153, 0.4) 100%);
    opacity: 0.8;
    transition: opacity 0.6s ease;
  }

  .cc-accordion-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    color: var(--blue-lightest);
    transform: translateY(20px);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cc-accordion-num {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    color: var(--yellow);
    margin-bottom: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease 0.1s;
  }

  .cc-accordion-title {
    font-family: var(--font-ui);
    font-size: clamp(14px, 2vw, 22px);
    text-transform: uppercase;
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    white-space: nowrap;
    
    /* Smooth rotation instead of writing-mode jump */
    transform-origin: left bottom;
    transform: rotate(-90deg) translateY(100%);
    opacity: 0.9;
    transition: transform 0.7s cubic-bezier(0.25, 1, 0.25, 1), font-size 0.7s ease, color 0.4s ease, opacity 0.4s ease;
  }

  .cc-accordion-desc {
    font-family: var(--font-body);
    font-size: 16px;
    opacity: 0;
    max-width: 300px;
    line-height: 1.4;
    transition: opacity 0.4s ease;
  }

  /* HOVER & EXPANDED STATES */
  .cc-accordion-panel:hover,
  .cc-accordion-panel.is-expanded {
    flex: 3;
    border-color: var(--yellow);
    box-shadow: inset 0 0 0 2px var(--yellow);
  }

  .cc-accordion-panel:hover .cc-accordion-bg,
  .cc-accordion-panel.is-expanded .cc-accordion-bg {
    filter: grayscale(0%) contrast(1.1);
    transform: scale(1.05);
  }

  .cc-accordion-panel:hover .cc-accordion-overlay,
  .cc-accordion-panel.is-expanded .cc-accordion-overlay {
    opacity: 0.4;
  }

  .cc-accordion-panel:hover .cc-accordion-content,
  .cc-accordion-panel.is-expanded .cc-accordion-content {
    transform: translateY(0);
  }

  .cc-accordion-panel:hover .cc-accordion-title,
  .cc-accordion-panel.is-expanded .cc-accordion-title {
    transform: rotate(0deg) translateY(0);
    font-size: clamp(20px, 3vw, 32px);
    color: var(--yellow);
    opacity: 1;
  }

  .cc-accordion-panel:hover .cc-accordion-num,
  .cc-accordion-panel.is-expanded .cc-accordion-num {
    opacity: 1;
    transform: translateY(0);
  }

  .cc-accordion-panel:hover .cc-accordion-desc,
  .cc-accordion-panel.is-expanded .cc-accordion-desc {
    opacity: 1;
    transition-delay: 0.2s;
  }

  @media (max-width: 768px) {
    .cc-accordion-container {
      flex-direction: column;
      min-height: 100%;
      height: auto;
    }
    .cc-accordion-title {
      writing-mode: horizontal-tb;
      transform: rotate(0deg);
      font-size: 28px;
    }
    .cc-accordion-panel {
      min-height: 160px;
      flex: none;
    }
    .cc-accordion-panel:hover,
    .cc-accordion-panel.is-expanded {
      height: 380px;
      flex: none;
    }
    .cc-accordion-panel:hover .cc-accordion-title,
    .cc-accordion-panel.is-expanded .cc-accordion-title {
      font-size: 32px;
      writing-mode: horizontal-tb;
      transform: rotate(0deg);
    }
  }
</style>

<script>
  // @ts-nocheck
import { gsap } from 'gsap';
  
  // Staggered entrance animation for the panels
  gsap.from('.cc-accordion-panel', {
    y: 100,
    opacity: 0,
    duration: 1,
    stagger: 0.15,
    ease: "power3.out",
    delay: 0.2
  });

  const panels = document.querySelectorAll('.cc-accordion-panel');
  let currentIndex = -1;

  function playPopOutAndNavigate(panel) {
    const href = panel.getAttribute('href');
    gsap.to(panel, {
      scale: 1.1,
      y: -30,
      opacity: 0,
      duration: 0.6,
      ease: "back.in(1.7)",
      onComplete: () => {
        if (href) window.location.href = href;
      }
    });
    panels.forEach(p => {
      if (p !== panel) gsap.to(p, { opacity: 0, duration: 0.4 });
    });
  }

  panels.forEach((panel, i) => {
    // Explicit double-click listener
    panel.addEventListener('dblclick', (e) => {
      e.preventDefault();
      playPopOutAndNavigate(panel);
    });

    panel.addEventListener('click', (e) => {
      e.preventDefault(); // always prevent default
      
      if (!panel.classList.contains('is-expanded')) {
        // First click: Expand
        panels.forEach(p => p.classList.remove('is-expanded'));
        panel.classList.add('is-expanded');
        currentIndex = i;
      } else {
        // Second click (slow double tap): Animate and navigate
        playPopOutAndNavigate(panel);
      }
    });
  });

  // Sidebar Controls Logic
  const selectBtns = document.querySelectorAll('[data-select-group="portfolio"]');
  const enterBtn = document.querySelector('[data-enter-group="portfolio"]');

  selectBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const dir = parseInt(btn.getAttribute('data-dir') || '1', 10);
      
      if (currentIndex === -1) {
        currentIndex = dir === 1 ? 0 : panels.length - 1;
      } else {
        currentIndex = (currentIndex + dir + panels.length) % panels.length;
      }
      
      panels.forEach(p => p.classList.remove('is-expanded'));
      if (panels[currentIndex]) {
        panels[currentIndex].classList.add('is-expanded');
      }
    });
  });

  if (enterBtn) {
    enterBtn.addEventListener('click', () => {
      if (currentIndex !== -1 && panels[currentIndex]) {
        const href = panels[currentIndex].getAttribute('href');
        const panel = panels[currentIndex];
        
        gsap.to(panel, {
          scale: 1.1,
          y: -30,
          opacity: 0,
          duration: 0.6,
          ease: "back.in(1.7)",
          onComplete: () => {
            if (href) window.location.href = href;
          }
        });
        
        panels.forEach(p => {
          if (p !== panel) gsap.to(p, { opacity: 0, duration: 0.4 });
        });
      }
    });
  }

  // --- TASK 1: Pull-Cord Work Light Switch Logic ---
  (async function initPullCord() {
    const stage = document.getElementById('portfolio-index-stage');
    const bulb = document.getElementById('portfolio-bulb');
    const cordHandle = document.getElementById('cord-handle');
    const cordString = document.getElementById('cord-string');
    const pulseRing = document.getElementById('cord-pulse-ring');
    const ghostHandEl = document.getElementById('cord-ghost-hand');
    const accordionPanels = Array.from(document.querySelectorAll('.cc-accordion-panel'));

    if (!cordHandle || !cordString || !stage) return;

    const { getGsapDraggable, isReducedMotion, springBack } = await import('../../utils/draggableHelper');
    const { initGuidance } = await import('../../utils/guidance');
    const { gsap, Draggable } = await getGsapDraggable();

    const reducedMotion = isReducedMotion();
    const STORAGE_KEY = 'cc:workLightOn';
    let isLit = false;

    // Check stored state on load - render immediately without replay of flicker animation
    try {
      if (localStorage.getItem(STORAGE_KEY) === '1') {
        isLit = true;
        stage.classList.add('is-lit');
        bulb?.classList.add('is-lit');
        cordHandle.setAttribute('aria-pressed', 'true');
      }
    } catch (e) {}

    function toggleLight() {
      guidance.stop();
      guidance.resetTimer();

      isLit = !isLit;
      cordHandle.setAttribute('aria-pressed', isLit ? 'true' : 'false');
      try {
        localStorage.setItem(STORAGE_KEY, isLit ? '1' : '0');
      } catch (e) {}

      if (reducedMotion) {
        stage.classList.toggle('is-lit', isLit);
        bulb?.classList.toggle('is-lit', isLit);
        return;
      }

      if (isLit) {
        // Filament flicker on bulb element
        gsap.timeline()
          .to(bulb, { opacity: 0.3, duration: 0.05 })
          .to(bulb, { opacity: 1, duration: 0.06 })
          .to(bulb, { opacity: 0.4, duration: 0.04 })
          .to(bulb, { opacity: 1, duration: 0.08 })
          .add(() => {
            bulb?.classList.add('is-lit');
            stage.classList.add('is-lit');
          })
          // Staggered light-up across the project cards
          .fromTo(accordionPanels, 
            { filter: 'brightness(0.85) contrast(0.95)' },
            { 
              filter: 'brightness(1.18) contrast(1.1)', 
              duration: 0.35, 
              stagger: 0.08, 
              ease: 'power2.out',
              onComplete: () => {
                gsap.set(accordionPanels, { clearProps: 'filter' });
              }
            }
          );
      } else {
        // Dim back to 75-80% baseline
        bulb?.classList.remove('is-lit');
        stage.classList.remove('is-lit');
      }
    }

    // Draggable downward
    const BASE_HEIGHT = 60;
    const MAX_PULL = 45;
    const PULL_THRESHOLD = 22;

    const cordDraggable = Draggable.create(cordHandle, {
      type: 'y',
      bounds: { minY: 0, maxY: MAX_PULL },
      edgeResistance: 0.75,
      zIndexBoost: true,
      onPress: function() {
        guidance.stop();
      },
      onDrag: function() {
        gsap.set(cordString, { height: BASE_HEIGHT + this.y });
      },
      onDragEnd: function() {
        if (this.y >= PULL_THRESHOLD) {
          // Cord click quick settle
          gsap.timeline({
            onComplete: () => {
              toggleLight();
            }
          })
          .to(cordHandle, { y: 0, duration: 0.22, ease: 'back.out(2.5)' })
          .to(cordString, { height: BASE_HEIGHT, duration: 0.22, ease: 'back.out(2.5)' }, 0);
        } else {
          // Springs back if not pulled far enough
          springBack(gsap, cordHandle, () => {
            guidance.resetTimer();
          });
          gsap.to(cordString, { height: BASE_HEIGHT, duration: 0.28, ease: 'power2.out' });
        }
      }
    })[0];

    // Guidance on handle (wiggle = gentle sway, ghost hand = downward pull, pulse ring)
    const guidance = initGuidance({
      targetEl: cordHandle,
      pulseEl: pulseRing,
      ghostHandEl,
      wiggleType: 'translateY',
      ghostHandType: 'drag',
      dragTargetEl: null,
      idleDelayMs: 3800
    });

    // Keyboard support: Enter / Space toggles instantly
    cordHandle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleLight();
      }
    });

    // Cleanup on cc:channel-jump navigation
    const cleanup = () => {
      guidance.destroy();
      if (cordDraggable) cordDraggable.kill();
      document.removeEventListener('cc:channel-jump', cleanup);
    };
    document.addEventListener('cc:channel-jump', cleanup);
  })();
</script>
