---
import Layout from '../../layouts/Layout.astro';
import SidebarNav from '../../components/SidebarNav.astro';
import Panel from '../../components/Panel.astro';
---
<Layout title="Portfolio">
  <div class="cc-inner-layout">
    <div class="cc-inner-layout__sidebar">
      <SidebarNav
        activePage="portfolio"
        pageTitle="Portfolio"
        pageDescription="A structured repository of past projects, creations, and design work across four distinct disciplines."
        controlGroup="portfolio"
        infoTitle="Portfolio Archive"
        infoMeta="Select a discipline to view specialized galleries and individual case studies."
      />
    </div>

    <div class="cc-inner-content">
      <Panel title="Select Discipline" showControls={false}>
        <div class="cc-portfolio-index">
          <div class="cc-accordion-container">
            
            <!-- FILMMAKING -->
            <a href="/portfolio/filmmaking" class="cc-accordion-panel" data-section="filmmaking">
              <div class="cc-accordion-bg" style="background-image: url('https://images.unsplash.com/photo-1485846234645-a62644f84728?q=80&w=2000&auto=format&fit=crop');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">01</div>
                <h2 class="cc-accordion-title">Filmmaking</h2>
                <div class="cc-accordion-desc">Cinematic narratives and visual storytelling.</div>
              </div>
            </a>

            <!-- PHOTOGRAPHY -->
            <a href="/portfolio/photography" class="cc-accordion-panel" data-section="photography">
              <div class="cc-accordion-bg" style="background-image: url('https://images.unsplash.com/photo-1516815231560-8f41ec531527?q=80&w=2000&auto=format&fit=crop');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">02</div>
                <h2 class="cc-accordion-title">Photography</h2>
                <div class="cc-accordion-desc">Frozen moments, shadows, and geometry.</div>
              </div>
            </a>

            <!-- DESIGN -->
            <a href="/portfolio/design" class="cc-accordion-panel" data-section="design">
              <div class="cc-accordion-bg" style="background-image: url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2000&auto=format&fit=crop');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">03</div>
                <h2 class="cc-accordion-title">Design</h2>
                <div class="cc-accordion-desc">Branding, typography, and strict precision.</div>
              </div>
            </a>

            <!-- ART -->
            <a href="/portfolio/art" class="cc-accordion-panel" data-section="art">
              <div class="cc-accordion-bg" style="background-image: url('https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?q=80&w=2000&auto=format&fit=crop');"></div>
              <div class="cc-accordion-overlay"></div>
              <div class="cc-accordion-content">
                <div class="cc-accordion-num">04</div>
                <h2 class="cc-accordion-title">Art</h2>
                <div class="cc-accordion-desc">Abstract, organic, and boundary-pushing.</div>
              </div>
            </a>

          </div>
        </div>
      </Panel>
    </div>
  </div>
</Layout>

<style>
  .cc-portfolio-index {
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--navy-deep);
  }

  .cc-accordion-container {
    display: flex;
    width: 100%;
    height: 85vh; /* Almost full height */
    gap: 8px; /* Space between panels */
    border: 2px solid var(--blue-panel-light);
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    background: var(--blue-column);
    padding: 8px;
  }

  .cc-accordion-panel {
    flex: 1;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    transition: flex 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    border: 1px solid var(--navy-deep);
    border-radius: 4px;
    group: accordion;
  }

  .cc-accordion-bg {
    position: absolute;
    inset: -10%; /* Extra space for panning */
    background-size: cover;
    background-position: center;
    filter: grayscale(100%) contrast(1.2);
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1), filter 0.6s ease;
  }

  .cc-accordion-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--navy-deep) 0%, rgba(0, 59, 153, 0.4) 100%);
    opacity: 0.8;
    transition: opacity 0.6s ease;
  }

  .cc-accordion-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    color: var(--blue-lightest);
    transform: translateY(20px);
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .cc-accordion-num {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    color: var(--yellow);
    margin-bottom: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease 0.1s;
  }

  .cc-accordion-title {
    font-family: var(--font-ui);
    font-size: 2vw;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    white-space: nowrap;
  }

  .cc-accordion-desc {
    font-family: var(--font-body);
    font-size: 16px;
    opacity: 0;
    max-width: 300px;
    line-height: 1.4;
    transition: opacity 0.4s ease;
  }

  /* HOVER & EXPANDED STATES */
  .cc-accordion-panel:hover,
  .cc-accordion-panel.is-expanded {
    flex: 3;
    border-color: var(--yellow);
    box-shadow: inset 0 0 0 2px var(--yellow);
  }

  .cc-accordion-panel:hover .cc-accordion-bg,
  .cc-accordion-panel.is-expanded .cc-accordion-bg {
    filter: grayscale(0%) contrast(1.1);
    transform: scale(1.05);
  }

  .cc-accordion-panel:hover .cc-accordion-overlay,
  .cc-accordion-panel.is-expanded .cc-accordion-overlay {
    opacity: 0.4;
  }

  .cc-accordion-panel:hover .cc-accordion-content,
  .cc-accordion-panel.is-expanded .cc-accordion-content {
    transform: translateY(0);
  }

  .cc-accordion-panel:hover .cc-accordion-title,
  .cc-accordion-panel.is-expanded .cc-accordion-title {
    writing-mode: horizontal-tb;
    transform: rotate(0deg);
    font-size: 3vw;
    color: var(--yellow);
  }

  .cc-accordion-panel:hover .cc-accordion-num,
  .cc-accordion-panel.is-expanded .cc-accordion-num {
    opacity: 1;
    transform: translateY(0);
  }

  .cc-accordion-panel:hover .cc-accordion-desc,
  .cc-accordion-panel.is-expanded .cc-accordion-desc {
    opacity: 1;
    transition-delay: 0.2s;
  }

  @media (max-width: 768px) {
    .cc-accordion-container {
      flex-direction: column;
    }
    .cc-accordion-title {
      writing-mode: horizontal-tb;
      transform: rotate(0deg);
      font-size: 24px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  
  // Staggered entrance animation for the panels
  gsap.from('.cc-accordion-panel', {
    y: 100,
    opacity: 0,
    duration: 1,
    stagger: 0.15,
    ease: "power3.out",
    delay: 0.2
  });

  // Single click to expand, double click (or second click) to navigate
  const panels = document.querySelectorAll('.cc-accordion-panel');
  let currentIndex = -1;

  panels.forEach((panel, i) => {
    panel.addEventListener('click', (e) => {
      if (!panel.classList.contains('is-expanded')) {
        // Prevent navigation on first click
        e.preventDefault();
        
        // Remove expanded class from all
        panels.forEach(p => p.classList.remove('is-expanded'));
        
        // Add expanded to this one
        panel.classList.add('is-expanded');
        currentIndex = i;
      }
      // If it IS expanded, let the default <a> behavior happen (navigate)
    });
  });

  // Sidebar Controls Logic
  const selectBtns = document.querySelectorAll('[data-select-group="portfolio"]');
  const enterBtn = document.querySelector('[data-enter-group="portfolio"]');

  selectBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const dir = parseInt(btn.getAttribute('data-dir') || '1', 10);
      
      if (currentIndex === -1) {
        currentIndex = dir === 1 ? 0 : panels.length - 1;
      } else {
        currentIndex = (currentIndex + dir + panels.length) % panels.length;
      }
      
      panels.forEach(p => p.classList.remove('is-expanded'));
      if (panels[currentIndex]) {
        panels[currentIndex].classList.add('is-expanded');
      }
    });
  });

  if (enterBtn) {
    enterBtn.addEventListener('click', () => {
      if (currentIndex !== -1 && panels[currentIndex]) {
        window.location.href = panels[currentIndex].getAttribute('href');
      }
    });
  }
</script>
