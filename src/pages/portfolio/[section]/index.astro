---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import FilmmakingGallery from '../../../components/portfolio/FilmmakingGallery.astro';
import PhotographyGallery from '../../../components/portfolio/PhotographyGallery.astro';
import DesignGallery from '../../../components/portfolio/DesignGallery.astro';
import ArtGallery from '../../../components/portfolio/ArtGallery.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('portfolio');
  
  // Extract unique sections
  const sections = [...new Set(allProjects.map((p) => p.data.section))];
  
  return sections.map((section) => {
    return {
      params: { section },
      props: { 
        projects: allProjects.filter((p) => p.data.section === section)
      }
    };
  });
}

const { section } = Astro.params;
const { projects } = Astro.props;

// Format title properly
const titleMap = {
  filmmaking: "Filmmaking",
  photography: "Photography",
  design: "Design",
  art: "Art"
};
const pageTitle = titleMap[section] || section;
---
<Layout title={`${pageTitle} Portfolio`}>
  <div class="cc-section-page">
    <header class="cc-section-header">
      <a href="/portfolio" class="cc-back-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        BACK TO PORTFOLIO
      </a>
      <h1 class="cc-section-title">{pageTitle}</h1>
      <div class="cc-section-count">{projects.length} PROJECTS</div>
    </header>

    <div class="cc-section-content">
      {section === 'filmmaking' && <FilmmakingGallery projects={projects} />}
      {section === 'photography' && <PhotographyGallery projects={projects} />}
      {section === 'design' && <DesignGallery projects={projects} />}
      {section === 'art' && <ArtGallery projects={projects} />}
    </div>
  </div>
</Layout>

<style>
  .cc-section-page {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .cc-section-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    border-bottom: 2px solid var(--blue-panel-light);
    margin-bottom: 20px;
  }

  .cc-back-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 700;
    color: var(--yellow);
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: transform 0.2s;
  }
  .cc-back-btn:hover {
    transform: translateX(-5px);
  }

  .cc-section-title {
    font-family: var(--font-ui);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--blue-lightest);
    margin: 0;
  }

  .cc-section-count {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--blue-panel-light);
    border: 1px solid var(--blue-panel-light);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .cc-section-content {
    flex: 1;
    min-height: 0; /* Important for inner scrolling */
    position: relative;
  }
  
  @media (max-width: 768px) {
    .cc-section-count {
      display: none;
    }
    .cc-section-header {
      padding: 15px 0;
      margin-bottom: 15px;
    }
    .cc-section-title {
      font-size: 18px;
    }
    .cc-back-btn {
      font-size: 10px;
    }
  }
</style>
