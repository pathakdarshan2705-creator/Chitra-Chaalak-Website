---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import FilterStudio from '../../../components/FilterStudio.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('portfolio');
  
  return allProjects.map((project) => {
    return {
      params: { 
        section: project.data.section,
        project: project.id.split('/').pop()
      },
      props: { project }
    };
  });
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={`${project.data.title} — ${project.data.section.toUpperCase()}`}>
  <div class="cc-project-page" id="project-page">
    <div class="cc-project-hero" id="project-hero">
      <img src={project.data.image} alt={project.data.title} class="cc-hero-img" id="hero-img" />
      <div class="cc-hero-overlay"></div>
      
      <div class="cc-hero-text">
        <a href={`/portfolio/${project.data.section}`} class="cc-hero-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          BACK TO {project.data.section.toUpperCase()}
        </a>
        <h1 class="cc-hero-title js-split-text">{project.data.title}</h1>
        <div class="cc-hero-meta js-fade-up">
          <span>{project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="cc-meta-divider">/</span>
          <span class="cc-meta-section">{project.data.section.toUpperCase()}</span>
        </div>
      </div>
    </div>

    {project.data.youtubeId && (
      <div class="cc-project-video">
        <iframe 
          src={`https://www.youtube.com/embed/${project.data.youtubeId}?autoplay=1&mute=1&loop=1&playlist=${project.data.youtubeId}&controls=0&showinfo=0&rel=0`}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>
    )}

    <div class="cc-project-content">
      <div class="cc-project-grid">
        <aside class="cc-project-sidebar js-fade-up">
          {project.data.description && (
            <div class="cc-project-desc">
              {project.data.description}
            </div>
          )}
          <div class="cc-project-meta-list">
            <div class="cc-meta-item">
              <span class="cc-meta-label">DISCIPLINE</span>
              <span class="cc-meta-value">{project.data.section.toUpperCase()}</span>
            </div>
            <div class="cc-meta-item">
              <span class="cc-meta-label">DATE</span>
              <span class="cc-meta-value">{project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
          </div>
        </aside>
        
        <div class="cc-project-markdown js-fade-up">
          <Content />
          {project.id.includes('art-image-filter') && (
            <div class="cc-filter-integration" style="margin-top: 60px;">
              <FilterStudio />
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .cc-project-video {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */
    height: 0;
    overflow: hidden;
    margin-bottom: 60px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #000;
  }
  .cc-project-video iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
  }
  .cc-project-page {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    position: relative;
    padding-bottom: 120px;
  }
  .cc-project-page::-webkit-scrollbar { display: none; }

  .cc-project-hero {
    position: relative;
    width: 100%;
    height: 80vh;
    border-bottom: 2px solid var(--yellow);
    overflow: hidden;
  }

  .cc-hero-img {
    width: 100%;
    height: 120%; /* extra height for intense parallax */
    object-fit: cover;
    transform-origin: center bottom;
  }

  .cc-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--navy-deep) 0%, rgba(0,20,50,0.2) 60%, transparent 100%);
  }

  .cc-hero-text {
    position: absolute;
    bottom: 60px;
    left: 60px;
    right: 60px;
    z-index: 10;
  }

  .cc-hero-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    color: var(--yellow);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 24px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .cc-hero-back:hover { 
    opacity: 0.8; 
    transform: translateX(-4px);
  }

  .cc-hero-title {
    font-family: var(--font-ui);
    font-size: clamp(40px, 6vw, 80px);
    color: var(--blue-lightest);
    margin: 0 0 16px 0;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -1px;
    overflow: hidden; /* for split text animation */
  }

  .cc-hero-meta {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--blue-panel-light);
    display: flex;
    align-items: center;
    gap: 16px;
    letter-spacing: 2px;
  }

  .cc-meta-divider { opacity: 0.5; color: var(--yellow); }
  .cc-meta-section { color: var(--yellow); font-weight: 700; }

  .cc-project-content {
    max-width: 1200px;
    margin: 100px auto 120px auto;
    padding: 0 40px;
    color: var(--blue-lightest);
    font-family: var(--font-body);
  }

  .cc-project-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 80px;
    align-items: start;
  }

  .cc-project-desc {
    font-size: 22px;
    font-weight: 400;
    color: var(--blue-lightest);
    line-height: 1.6;
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(103, 200, 255, 0.15);
  }

  .cc-project-meta-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cc-meta-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cc-meta-label {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--blue-panel-light);
  }

  .cc-meta-value {
    font-size: 16px;
    color: var(--yellow);
    font-weight: 600;
  }

  .cc-project-markdown {
    font-size: 20px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Editorial Markdown Styles */
  .cc-project-markdown :global(h2) {
    font-family: var(--font-ui);
    color: var(--yellow);
    margin-top: 60px;
    margin-bottom: 20px;
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 10px;
  }
  
  .cc-project-markdown :global(p) {
    margin-bottom: 24px;
  }

  .cc-project-markdown :global(blockquote) {
    font-size: 28px;
    line-height: 1.4;
    font-style: italic;
    color: #fff;
    margin: 60px 0;
    padding: 0 0 0 30px;
    background: transparent;
    border-left: 2px solid var(--yellow);
  }
  
  .cc-project-markdown :global(ul) {
    margin-bottom: 30px;
    padding-left: 20px;
  }
  .cc-project-markdown :global(li) {
    margin-bottom: 10px;
  }
  
  .cc-project-markdown :global(strong) {
    color: var(--yellow);
    font-weight: 700;
  }
  
  @media (max-width: 900px) {
    .cc-hero-text { left: 20px; right: 20px; bottom: 40px; }
    .cc-project-content { padding: 0 20px; margin-top: 60px; }
    .cc-project-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .cc-project-desc {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 30px;
    }
    .cc-project-meta-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 30px;
      padding-bottom: 40px;
      border-bottom: 1px solid rgba(103, 200, 255, 0.15);
    }
    .cc-project-markdown :global(blockquote) { margin: 40px 0; padding-left: 20px; font-size: 24px; }
  }
</style>

<script>
  // @ts-nocheck
import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Parallax the hero image and fade it out
  const scroller = document.getElementById('project-page');
  const heroImg = document.getElementById('hero-img');
  const heroText = document.querySelector('.cc-hero-text');
  
  if (scroller && heroImg && heroText) {
    gsap.to(heroImg, {
      yPercent: 30, // move down as we scroll down
      scale: 1.1,
      opacity: 0.3,
      ease: "none",
      scrollTrigger: {
        trigger: ".cc-project-hero",
        scroller: scroller,
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });

    gsap.to(heroText, {
      y: 50,
      opacity: 0,
      ease: "none",
      scrollTrigger: {
        trigger: ".cc-project-hero",
        scroller: scroller,
        start: "top top",
        end: "center top",
        scrub: true
      }
    });
  }

  // Entrance animations
  gsap.from('.cc-hero-title', {
    y: 50, opacity: 0, duration: 1, ease: "power4.out", delay: 0.2
  });
  
  gsap.from('.js-fade-up', {
    y: 40, opacity: 0, duration: 1, stagger: 0.2, ease: "power3.out", delay: 0.4
  });
</script>
