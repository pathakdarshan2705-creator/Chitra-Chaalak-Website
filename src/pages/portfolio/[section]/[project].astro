---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('portfolio');
  
  return allProjects.map((project) => {
    return {
      params: { 
        section: project.data.section,
        project: project.slug 
      },
      props: { project }
    };
  });
}

const { project } = Astro.props;
const { Content } = await project.render();
---
<Layout title={`${project.data.title} — ${project.data.section.toUpperCase()}`}>
  <div class="cc-project-page">
    <div class="cc-project-hero">
      <img src={project.data.image} alt={project.data.title} class="cc-hero-img" />
      <div class="cc-hero-overlay"></div>
      
      <div class="cc-hero-text">
        <a href={`/portfolio/${project.data.section}`} class="cc-hero-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          BACK TO {project.data.section.toUpperCase()}
        </a>
        <h1 class="cc-hero-title">{project.data.title}</h1>
        <div class="cc-hero-meta">
          <span>{project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span class="cc-meta-divider">/</span>
          <span class="cc-meta-section">{project.data.section.toUpperCase()}</span>
        </div>
      </div>
    </div>

    <div class="cc-project-content">
      <div class="cc-project-desc">{project.data.description}</div>
      <div class="cc-project-markdown">
        <Content />
      </div>
    </div>
  </div>
</Layout>

<style>
  .cc-project-page {
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    position: relative;
    padding-bottom: 60px;
  }
  .cc-project-page::-webkit-scrollbar { display: none; }

  .cc-project-hero {
    position: relative;
    width: 100%;
    height: 60vh;
    border-bottom: 2px solid var(--yellow);
    overflow: hidden;
  }

  .cc-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1); /* for gsap scroll effect */
  }

  .cc-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--navy-deep) 0%, transparent 100%);
  }

  .cc-hero-text {
    position: absolute;
    bottom: 40px;
    left: 40px;
    right: 40px;
  }

  .cc-hero-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    color: var(--yellow);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    transition: opacity 0.2s;
  }
  .cc-hero-back:hover { opacity: 0.8; }

  .cc-hero-title {
    font-family: var(--font-ui);
    font-size: clamp(32px, 4vw, 56px);
    color: var(--blue-lightest);
    margin: 0 0 10px 0;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .cc-hero-meta {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--blue-panel-light);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cc-meta-divider { opacity: 0.5; }
  .cc-meta-section { color: var(--yellow); font-weight: 700; }

  .cc-project-content {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 24px;
    color: var(--blue-lightest);
    font-family: var(--font-body);
  }

  .cc-project-desc {
    font-size: 22px;
    font-weight: 600;
    color: var(--yellow);
    margin-bottom: 40px;
    line-height: 1.5;
  }

  .cc-project-markdown {
    font-size: 18px;
    line-height: 1.7;
    opacity: 0.9;
  }

  .cc-project-markdown :global(h2) {
    font-family: var(--font-ui);
    color: var(--blue-panel-light);
    margin-top: 40px;
    font-size: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Parallax the hero image
  const img = document.querySelector('.cc-hero-img');
  if (img) {
    gsap.to(img, {
      yPercent: 20,
      ease: "none",
      scrollTrigger: {
        trigger: ".cc-project-hero",
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });
  }
</script>
