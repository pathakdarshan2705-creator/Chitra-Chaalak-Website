---
// src/pages/collections/index.astro
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/Panel.astro';
import SidebarNav from '../../components/SidebarNav.astro';
import Card from '../../components/Card.astro';
---

<Layout title="Visual Collection">
  <div class="cc-inner-layout">
    <div class="cc-inner-layout__sidebar">
      <SidebarNav
        activePage="collections"
        pageTitle="The Collection"
        pageDescription="I have a habit of keeping things.<br><br>Some of them make sense like books, records, cameras, photographs. Some probably don't like stamps, stones, old prints, little objects, images, ideas, and things I came across and decided I wanted to keep.<br><br>I’ve never really had a reason for collecting any of it. Sometimes it’s because something is beautiful, sometimes because it reminds me of a place or a person, and sometimes simply because I like having it around.<br><br>This is where I’ll put those collections as they grow. A slightly messy archive of the things that have caught my eye and somehow ended up staying with me."
        controlGroup="collections"
        infoTitle="The Collection"
        infoMeta="A collection of things I couldn’t stop collecting."
      />
    </div>

    <div class="cc-inner-content">
      <Panel title="The Collection" showControls={false}>
        <div class="cc-tour-page">
          <div class="cc-card-list">
            <Card
              href="/collections/music"
              title="Music Collection"
              meta="ROTATION"
              imageSrc="https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?q=80&w=600&auto=format&fit=crop"
              group="collections"
            />
            <!-- In the future, add more cards here like Photography, Cameras, etc. -->
          </div>
        </div>
      </Panel>
    </div>
  </div>
</Layout>

<style>
  .cc-tour-page {
    padding: 20px;
    height: 100%;
    overflow-y: auto;
  }

  .cc-card-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
</style>
