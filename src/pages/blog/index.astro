---
// src/pages/blog/index.astro — "Making Sense": the full blog archive.
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/Panel.astro';
import SidebarNav from '../../components/SidebarNav.astro';
import BlogCalendar from '../../components/BlogCalendar.astro';
import BlogFeatured from '../../components/BlogFeatured.astro';
import BlogGridCard from '../../components/BlogGridCard.astro';
import FarmaishPostcard from '../../components/FarmaishPostcard.astro';
import { getCollection } from 'astro:content';

// Placement constant: set to 'below' (default) or 'above' to move the postcard relative to the post list
export const POSTCARD_PLACEMENT: 'below' | 'above' = 'below';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function isoDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
function displayDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
}

const posts = sorted.map((post) => ({
  iso: isoDate(post.data.date),
  dateDisplay: displayDate(post.data.date),
  title: post.data.title,
  topic: post.data.topic,
  excerpt: post.data.excerpt ?? '',
  image: post.data.image,
  imageAlt: post.data.imageAlt ?? post.data.title,
  href: `/blog/${post.id}`,
}));

const availableDates = posts.map((p) => p.iso);

const todayIso = isoDate(new Date());
const featured =
  posts.find((p) => p.iso === todayIso) ??
  posts.find((p) => p.iso < todayIso) ??
  posts[0];

const postsMap = Object.fromEntries(
  posts.map((p) => [p.iso, {
    title: p.title, dateDisplay: p.dateDisplay, topic: p.topic,
    excerpt: p.excerpt, image: p.image, href: p.href,
  }])
);
---
<Layout title="Blogs — Making Sense">
  <div class="cc-inner-layout">
    <div class="cc-inner-layout__sidebar">
      <SidebarNav
        activePage="blog"
        pageTitle="Making Sense"
        pageDescription="There is too much happening to have an opinion about everything, but too much to ignore everything either.<br><br>This is where I write about whatever catches my attention whether it is about politics, or current affairs, or art, or films, or sports, or travel, or food, or literature, or culture, or some completely unexpected subject.<br><br>Some pieces might be carefully thought out. Others might simply begin with a question I can’t stop thinking about. I’m not trying to have the final word on anything. I’m just trying to look a little closer, make a few connections, and understand things in my own way."
        controlGroup="blog-archive"
        infoTitle="Making Sense"
        infoMeta="A place to think out loud about the things happening around me."
      />
    </div>

    <div class="cc-inner-content">
      <Panel title="Making Sense" showControls={false}>
        <Fragment slot="header-extra">
          <BlogCalendar availableDates={availableDates} initialDate={featured?.iso ?? todayIso} />
        </Fragment>

        <div class="cc-blog-page">
          {featured ? (
            <BlogFeatured
              title={featured.title}
              date={featured.dateDisplay}
              topic={featured.topic}
              excerpt={featured.excerpt}
              imageSrc={featured.image}
              imageAlt={featured.imageAlt}
              href={featured.href}
            />
          ) : (
            <div style="padding: 40px 20px; text-align: center; color: var(--yellow); font-family: var(--font-mono); letter-spacing: 1px; font-size: 13px;">
              [ ARCHIVE EMPTY // NO DISPATCHES FOUND ]
            </div>
          )}

          {POSTCARD_PLACEMENT === 'above' && <FarmaishPostcard />}

          {posts.length > 0 && (
            <div class="cc-blog-grid">
              {posts.map((p) => (
                <BlogGridCard
                  href={p.href}
                  title={p.title}
                  date={p.dateDisplay}
                  topic={p.topic}
                  imageSrc={p.image}
                  imageAlt={p.imageAlt}
                  group="blog-archive"
                />
              ))}
            </div>
          )}

          {POSTCARD_PLACEMENT === 'below' && <FarmaishPostcard />}
        </div>
      </Panel>
    </div>
  </div>

  <!-- Floating Circle Letter Icon: Quick jump directly to Farmaish Postbox -->
  <button
    type="button"
    class="cc-farmaish-jump-btn"
    id="farmaish-jump-btn"
    aria-label="Jump to Farmaish request postcard"
    title="Farmaish Postbox"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
    </svg>
  </button>
</Layout>

<style is:global>
  .cc-blog-page{
    padding: 20px;
  }

  .cc-blog-grid{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* Floating Circle Envelope/Letter Icon */
  .cc-farmaish-jump-btn {
    position: fixed !important;
    bottom: 84px !important;
    right: 36px !important;
    width: 52px !important;
    height: 52px !important;
    border-radius: 50% !important;
    background: var(--navy-deep) !important;
    color: var(--yellow) !important;
    border: 2px solid var(--yellow) !important;
    box-shadow: 0 4px 20px rgba(0, 10, 40, 0.9), 0 0 14px rgba(255, 240, 0, 0.45) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    z-index: 9990 !important; /* above CRT layers & footer, below custom cursor */
    pointer-events: auto !important;
    transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.3, 1), background 0.15s ease, color 0.15s ease, box-shadow 0.2s ease !important;
  }

  .cc-farmaish-jump-btn svg {
    display: block !important;
    width: 24px !important;
    height: 24px !important;
    stroke: currentColor !important;
    pointer-events: none !important;
  }

  .cc-farmaish-jump-btn:hover {
    background: var(--yellow) !important;
    color: var(--navy-deep) !important;
    transform: translateY(-3px) scale(1.08) !important;
    box-shadow: 0 8px 26px rgba(0, 10, 40, 0.95), 0 0 22px rgba(255, 240, 0, 0.7) !important;
  }

  .cc-farmaish-jump-btn:active {
    transform: translateY(1px) scale(0.95) !important;
    box-shadow: 0 3px 10px rgba(0, 10, 40, 0.7) !important;
  }

  @media (max-width: 1100px){
    .cc-blog-grid{ grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px){
    .cc-blog-grid{ grid-template-columns: 1fr; gap: 12px; }
    .cc-blog-page{ padding: 12px; }
    .cc-farmaish-jump-btn {
      bottom: 74px !important;
      right: 20px !important;
      width: 46px !important;
      height: 46px !important;
    }
    .cc-farmaish-jump-btn svg {
      width: 21px !important;
      height: 21px !important;
    }
  }
</style>

<script define:vars={{ postsMap }}>
  window.__ccBlogPosts = postsMap;

  // Clear any default or lingering selection on blog cards
  document.querySelectorAll('.cc-card.is-selected').forEach((el) => {
    el.classList.remove('is-selected');
  });

  const jumpBtn = document.getElementById('farmaish-jump-btn');
  if (jumpBtn) {
    // Mount to document.body so fixed positioning is relative to viewport without clipping
    if (jumpBtn.parentElement !== document.body) {
      document.body.appendChild(jumpBtn);
    }

    jumpBtn.addEventListener('click', () => {
      const postcard = document.getElementById('cc-postcard') || document.querySelector('.cc-farmaish-section');
      if (postcard) {
        postcard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setTimeout(() => {
          const textarea = document.getElementById('farmaish-message');
          textarea?.focus();
        }, 500);
      }
    });

    // Clean up button when navigating away
    document.addEventListener('cc:channel-jump', () => {
      jumpBtn.remove();
    }, { once: true });
  }
</script>