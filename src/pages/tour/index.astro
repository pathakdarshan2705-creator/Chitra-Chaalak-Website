---
// src/pages/tour/index.astro
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/Panel.astro';
import SidebarNav from '../../components/SidebarNav.astro';
import { getCollection } from 'astro:content';

const allTours = await getCollection('tour');
const sortedTours = allTours.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function displayDate(d: Date | string) {
  const dateObj = new Date(d);
  if (isNaN(dateObj.getTime())) return "DATE ARCHIVE";
  return dateObj.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
}

// Assemble reel photos from tours and library tour images
// Each photo is tagged with a specific city for city-wise filtering and overall reel
const reelPhotos = [
  {
    id: 'kolkata-1',
    title: 'Kolkata Streets & Tramways',
    city: 'KOLKATA',
    location: 'KOLKATA',
    dateDisplay: sortedTours.find(t => t.id === 'new-york') ? displayDate(sortedTours.find(t => t.id === 'new-york')!.data.date) : 'MAR 2026',
    image: '/images/tour/kolkata_cover.jpg',
    href: '/tour/new-york'
  },
  {
    id: 'paris-1',
    title: 'Boulevards & Metro Gates',
    city: 'PARIS',
    location: 'PARIS',
    dateDisplay: sortedTours.find(t => t.id === 'paris') ? displayDate(sortedTours.find(t => t.id === 'paris')!.data.date) : 'OCT 2025',
    image: '/images/tour/paris_cover.png',
    href: '/tour/paris'
  },
  {
    id: 'paris-2',
    title: 'Latin Quarter After Midnight',
    city: 'PARIS',
    location: 'PARIS',
    dateDisplay: 'OCT 2025',
    image: '/images/tour/paris_1.png',
    href: '/tour/paris'
  },
  {
    id: 'paris-3',
    title: 'Passages Couverts & Kiosks',
    city: 'PARIS',
    location: 'PARIS',
    dateDisplay: 'OCT 2025',
    image: '/images/tour/paris_2.png',
    href: '/tour/paris'
  },
  {
    id: 'tokyo-1',
    title: 'Shinjuku Alleyways & Neon',
    city: 'TOKYO',
    location: 'TOKYO',
    dateDisplay: sortedTours.find(t => t.id === 'tokyo') ? displayDate(sortedTours.find(t => t.id === 'tokyo')!.data.date) : 'NOV 2025',
    image: '/images/tour/tokyo_cover.png',
    href: '/tour/tokyo'
  },
  {
    id: 'tokyo-2',
    title: 'Yamanote Platform Dusk',
    city: 'TOKYO',
    location: 'TOKYO',
    dateDisplay: 'NOV 2025',
    image: '/images/tour/tokyo_1.png',
    href: '/tour/tokyo'
  },
  {
    id: 'tokyo-3',
    title: 'Asakusa Lanterns',
    city: 'TOKYO',
    location: 'TOKYO',
    dateDisplay: 'NOV 2025',
    image: '/images/tour/tokyo_2.png',
    href: '/tour/tokyo'
  }
];

// Available cities for settings selector
const availableCities = ['ALL', ...Array.from(new Set(reelPhotos.map(p => p.city)))];
---

<Layout title="Visual Tour — Chitra Chaalak">
  <div class="cc-inner-layout">
    <div class="cc-inner-layout__sidebar">
      <SidebarNav
        activePage="tour"
        pageTitle="Visual Tours"
        pageDescription="I like getting lost in places.<br><br>Not necessarily in the dramatic sense but sometimes it’s just taking a road I’ve never taken, stopping for a chai, noticing an old signboard, watching people go about their day, or finding a corner of a city that wasn’t on any itinerary.<br><br>Whenever I travel, I try to collect these little things along the way. The photographs, the places, the people, the food, the conversations and the moments that made the place feel like itself.<br><br>This is my way of taking you along. Not a travel guide, not a checklist of things to see, just a place as I happened to experience it."
        controlGroup="tour-reel"
        infoTitle="Visual Tours"
        infoMeta="Come walk around with me. Use the rotary reel to view city-wise or overall."
      />
    </div>

    <div class="cc-inner-content">
      <Panel title="Visual Tours — View-Master Reel" showControls={false}>
        <div class="cc-viewmaster-container">

          <!-- View-Master Retro Viewer Chassis -->
          <div class="cc-viewmaster">
            <div class="cc-viewmaster__hood">
              <div class="cc-viewmaster__badge">
                <span class="cc-vm-logo">VIEW-MASTER</span>
                <span class="cc-vm-sub">STEREOSCOPIC ROTARY REEL</span>
              </div>

              <!-- Mechanical Advancing Lever -->
              <div class="cc-viewmaster__lever-housing">
                <button
                  type="button"
                  class="cc-viewmaster-lever"
                  id="viewmaster-lever"
                  tabindex="0"
                  aria-label="Click lever to advance View-Master reel. Or use ArrowRight/ArrowLeft."
                >
                  <div class="cc-lever-arm">
                    <span class="cc-lever-ribs"></span>
                    <span class="cc-lever-knob"></span>
                  </div>
                  <div class="cc-lever-pulse-ring" id="lever-pulse-ring" aria-hidden="true"></div>
                </button>

                <!-- Ghost hand guidance on lever -->
                <div class="cc-ghost-hand cc-lever-ghost-hand" id="lever-ghost-hand" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff000" stroke-width="2">
                    <path d="M18 11V6a2 2 0 0 0-4 0v5" />
                    <path d="M14 10V4a2 2 0 0 0-4 0v7" />
                    <path d="M10 10.5V6a2 2 0 0 0-4 0v8" />
                    <path d="M6 14v1a6 6 0 0 0 12 0v-4" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- View-Master Settings: City Reel Selector -->
            <div class="cc-vm-settings-bar">
              <div class="cc-vm-settings-badge">
                <span class="cc-vm-settings-icon">⚙</span>
                <span class="cc-vm-settings-text">REEL SETTING:</span>
              </div>
              <div class="cc-vm-cities-wrap" role="tablist" aria-label="City or overall reel selection">
                <button
                  type="button"
                  class="cc-vm-city-pill is-active"
                  data-city="ALL"
                  role="tab"
                  aria-selected="true"
                  aria-label="Overall website reel across all cities"
                >
                  <span class="cc-city-star">★</span>
                  <span>OVERALL (ALL CITIES)</span>
                </button>
                {availableCities.filter(c => c !== 'ALL').map(c => (
                  <button
                    type="button"
                    class="cc-vm-city-pill"
                    data-city={c}
                    role="tab"
                    aria-selected="false"
                    aria-label={`View ${c} city reel`}
                  >
                    <span>{c}</span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Viewport Stage -->
            <div class="cc-viewmaster__viewport">
              <div class="cc-viewmaster__window-frame" id="viewmaster-stage">
                <!-- Active Slide Display -->
                <div class="cc-vm-slide" id="vm-active-slide">
                  <img
                    id="vm-slide-img"
                    src={reelPhotos[0].image}
                    alt={reelPhotos[0].title}
                    class="cc-vm-slide__img"
                  />

                  <!-- Stamped location tag overlay -->
                  <div class="cc-vm-location-stamp" id="vm-location-stamp">
                    <span class="cc-stamp-icon">★</span>
                    <span class="cc-stamp-text" id="vm-location-text">{reelPhotos[0].location}</span>
                  </div>

                  <!-- Frame Meta Info -->
                  <div class="cc-vm-meta-bar">
                    <span class="cc-vm-counter" id="vm-counter">01 / {reelPhotos.length.toString().padStart(2, '0')}</span>
                    <span class="cc-vm-title" id="vm-slide-title">{reelPhotos[0].title}</span>
                    <a
                      id="vm-story-link"
                      href={reelPhotos[0].href}
                      class="cc-vm-story-btn"
                      title="Open full tour photo essay"
                    >
                      <span>VIEW STORY</span>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                    </a>
                    <span class="cc-vm-date" id="vm-slide-date">{reelPhotos[0].dateDisplay}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Reel Filmstrip Edge Underneath -->
            <div class="cc-reel-strip-wrap">
              <div class="cc-reel-sprockets top"></div>
              <div class="cc-reel-strip" id="reel-strip">
                {reelPhotos.map((photo, i) => (
                  <button
                    type="button"
                    class={`cc-reel-thumb ${i === 0 ? 'is-active' : ''}`}
                    data-city={photo.city}
                    data-id={photo.id}
                    data-all-index={i}
                    aria-label={`View photo: ${photo.title}`}
                  >
                    <img src={photo.image} alt={photo.title} loading="lazy" />
                    <span class="cc-reel-thumb-num">{i + 1}</span>
                  </button>
                ))}
              </div>
              <div class="cc-reel-sprockets bottom"></div>
            </div>

            <!-- Hidden data carrier for bundled script -->
            <div id="viewmaster-data" data-photos={JSON.stringify(reelPhotos)} hidden></div>

          </div>

        </div>
      </Panel>
    </div>
  </div>

  <script>
    import { getGsapDraggable, isReducedMotion } from '../../utils/draggableHelper';
    import { initGuidance } from '../../utils/guidance';

    (async function initViewMaster() {
      const dataEl = document.getElementById('viewmaster-data');
      let allReelPhotos: any[] = [];
      try {
        allReelPhotos = dataEl ? JSON.parse(dataEl.getAttribute('data-photos') || '[]') : [];
      } catch (err) {
        console.error('Failed to parse reelPhotos', err);
      }

      if (allReelPhotos.length === 0) return;

      const leverBtn = document.getElementById('viewmaster-lever');
      const pulseRing = document.getElementById('lever-pulse-ring');
      const ghostHandEl = document.getElementById('lever-ghost-hand');
      const slideImg = document.getElementById('vm-slide-img') as HTMLImageElement | null;
      const locText = document.getElementById('vm-location-text');
      const titleEl = document.getElementById('vm-slide-title');
      const dateEl = document.getElementById('vm-slide-date');
      const counterEl = document.getElementById('vm-counter');
      const storyLink = document.getElementById('vm-story-link') as HTMLAnchorElement | null;
      const stageEl = document.getElementById('vm-active-slide');
      const cityPills = Array.from(document.querySelectorAll<HTMLElement>('.cc-vm-city-pill'));
      const thumbBtns = Array.from(document.querySelectorAll<HTMLElement>('.cc-reel-thumb'));

      if (!leverBtn || !slideImg) return;

      const { gsap } = await getGsapDraggable();

      let currentCity = 'ALL';
      let activePhotos = [...allReelPhotos];
      let currentIndex = 0;
      let isAnimating = false;
      const reducedMotion = isReducedMotion();

      function refreshThumbnails() {
        let visibleCount = 0;
        thumbBtns.forEach((tb) => {
          const itemCity = tb.dataset.city;
          const isVisible = currentCity === 'ALL' || itemCity === currentCity;
          if (isVisible) {
            tb.style.display = 'block';
            visibleCount++;
            const numEl = tb.querySelector('.cc-reel-thumb-num');
            if (numEl) numEl.textContent = String(visibleCount);

            const currentPhoto = activePhotos[currentIndex];
            const isSelected = currentPhoto && tb.dataset.id === currentPhoto.id;
            tb.classList.toggle('is-active', isSelected);
            if (isSelected) {
              tb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          } else {
            tb.style.display = 'none';
            tb.classList.remove('is-active');
          }
        });
      }

      function updateSlide(nextIndex: number, direction: number = 1) {
        if (isAnimating || activePhotos.length === 0) return;
        if (nextIndex < 0) nextIndex = activePhotos.length - 1;
        if (nextIndex >= activePhotos.length) nextIndex = 0;

        currentIndex = nextIndex;
        const photo = activePhotos[currentIndex];

        refreshThumbnails();

        const applyContent = () => {
          if (slideImg) {
            slideImg.src = photo.image;
            slideImg.alt = photo.title;
          }
          if (locText) locText.textContent = photo.location || photo.city;
          if (titleEl) titleEl.textContent = photo.title;
          if (dateEl) dateEl.textContent = photo.dateDisplay;
          if (storyLink) storyLink.href = photo.href;
          if (counterEl) {
            counterEl.textContent = `${(currentIndex + 1).toString().padStart(2, '0')} / ${activePhotos.length.toString().padStart(2, '0')}`;
          }
        };

        if (reducedMotion || !stageEl) {
          applyContent();
          return;
        }

        isAnimating = true;

        // Mechanical carousel-turn transition: rotate & skew during turn, then settle
        const outSkew = direction * 5;
        const outRot = direction * -12;
        const inRot = direction * 12;

        gsap.timeline({
          onComplete: () => {
            isAnimating = false;
          }
        })
        .to(stageEl, {
          rotateY: outRot,
          skewY: outSkew,
          scale: 0.94,
          opacity: 0.35,
          duration: 0.16,
          ease: 'power2.in',
          onComplete: applyContent
        })
        .set(stageEl, { rotateY: inRot, skewY: -outSkew, scale: 0.94 })
        .to(stageEl, {
          rotateY: 0,
          skewY: 0,
          scale: 1,
          opacity: 1,
          duration: 0.22,
          ease: 'back.out(1.3)'
        });
      }

      function setCity(city: string) {
        if (city === currentCity && activePhotos.length > 0) return;
        currentCity = city;
        activePhotos = currentCity === 'ALL'
          ? [...allReelPhotos]
          : allReelPhotos.filter(p => p.city === currentCity);

        cityPills.forEach((p) => {
          const match = p.dataset.city === currentCity;
          p.classList.toggle('is-active', match);
          p.setAttribute('aria-selected', String(match));
        });

        currentIndex = 0;
        updateSlide(0, 1);
      }

      cityPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const city = pill.dataset.city || 'ALL';
          setCity(city);
        });
      });

      function pressLever(direction: number = 1) {
        guidance.stop();
        guidance.resetTimer();

        if (!reducedMotion) {
          // Mechanical lever-press animation: short rotation + spring back
          gsap.timeline()
            .to(leverBtn, { rotation: 22, duration: 0.1, ease: 'power2.in' })
            .to(leverBtn, { rotation: 0, duration: 0.22, ease: 'back.out(2)' });
        }

        updateSlide(currentIndex + direction, direction);
      }

      // Guidance on the lever
      const guidance = initGuidance({
        targetEl: leverBtn,
        pulseEl: pulseRing,
        ghostHandEl,
        wiggleType: 'press',
        ghostHandType: 'press',
        idleDelayMs: 3800
      });

      // Lever click
      leverBtn.addEventListener('click', () => {
        pressLever(1);
      });

      // Clicking main photo slide also advances to next photo (unless clicking on interactive link)
      stageEl?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement)?.closest('a, button')) return;
        pressLever(1);
      });

      // Keyboard controls on lever: Enter/Space/ArrowRight advances, ArrowLeft goes back
      leverBtn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowRight') {
          e.preventDefault();
          pressLever(1);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          pressLever(-1);
        }
      });

      // Direct thumbnail click on the reel strip
      thumbBtns.forEach((tb) => {
        tb.addEventListener('click', () => {
          const id = tb.dataset.id;
          const idx = activePhotos.findIndex(p => p.id === id);
          if (idx !== -1) {
            const dir = idx >= currentIndex ? 1 : -1;
            updateSlide(idx, dir);
          }
        });
      });

      // Mobile Touch Swipe support on Viewport
      let touchStartX = 0;
      let touchStartY = 0;
      stageEl?.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }, { passive: true });

      stageEl?.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const diffX = touchEndX - touchStartX;
        const diffY = touchEndY - touchStartY;
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            pressLever(1); // Swipe left -> advance
          } else {
            pressLever(-1); // Swipe right -> previous
          }
        }
      }, { passive: true });

      // Connect Sidebar navigation buttons
      document.querySelectorAll('[data-select-group="tour-reel"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = parseInt((btn as HTMLElement).dataset.dir || '1', 10);
          pressLever(dir);
        });
      });

      document.querySelectorAll('[data-enter-group="tour-reel"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const currentPhoto = activePhotos[currentIndex];
          if (currentPhoto && currentPhoto.href && currentPhoto.href !== '#') {
            document.dispatchEvent(new CustomEvent('cc:channel-jump'));
            setTimeout(() => {
              window.location.href = currentPhoto.href;
            }, 200);
          }
        });
      });

      // Initial state
      refreshThumbnails();

      // Reset state if restored from bfcache
      window.addEventListener('pageshow', () => {
        guidance.resetTimer();
        if (stageEl) gsap.set(stageEl, { clearProps: 'all' });
      });

      // Cleanup on cc:channel-jump navigation
      const cleanup = () => {
        guidance.destroy();
        document.removeEventListener('cc:channel-jump', cleanup);
      };
      document.addEventListener('cc:channel-jump', cleanup);
    })();
  </script>
</Layout>

<style>
  .cc-viewmaster-container {
    padding: 24px;
    height: 100%;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* --- View-Master Chassis --- */
  .cc-viewmaster {
    width: 100%;
    max-width: 820px;
    background: linear-gradient(180deg, #102d60 0%, #00122e 100%);
    border: 3px solid var(--blue-panel-light);
    border-radius: 12px;
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    padding: 20px;
    position: relative;
    perspective: 1000px;
  }

  .cc-viewmaster__hood {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(103, 200, 255, 0.25);
    padding-bottom: 12px;
  }

  .cc-viewmaster__badge {
    display: flex;
    flex-direction: column;
  }

  .cc-vm-logo {
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--yellow);
    letter-spacing: 2.5px;
    text-shadow: 0 0 8px rgba(255, 240, 0, 0.4);
  }

  .cc-vm-sub {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 1.5px;
    color: var(--blue-lightest);
    opacity: 0.8;
  }

  /* --- View-Master Settings Bar (City & Overall Mode) --- */
  .cc-vm-settings-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(0, 15, 40, 0.7);
    border: 1px solid rgba(103, 200, 255, 0.25);
    border-radius: 6px;
    padding: 6px 12px;
    margin-bottom: 14px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .cc-vm-settings-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--blue-panel-light);
    white-space: nowrap;
  }

  .cc-vm-settings-icon {
    font-size: 12px;
    color: var(--yellow);
  }

  .cc-vm-cities-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 2px 0;
  }

  .cc-vm-cities-wrap::-webkit-scrollbar {
    display: none;
  }

  .cc-vm-city-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(4, 25, 60, 0.8);
    border: 1.5px solid var(--blue-panel-light);
    border-radius: 4px;
    color: var(--blue-lightest);
    font-family: var(--font-ui);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 5px 11px;
    cursor: pointer;
    white-space: nowrap;
    outline: none;
    transition: all 0.2s ease;
    touch-action: manipulation;
  }

  .cc-vm-city-pill:hover {
    border-color: var(--yellow);
    color: #ffffff;
    box-shadow: 0 0 8px rgba(255, 240, 0, 0.25);
  }

  .cc-vm-city-pill.is-active {
    background: var(--yellow);
    border-color: var(--yellow);
    color: var(--navy-deep);
    box-shadow: 0 0 12px rgba(255, 240, 0, 0.45);
  }

  .cc-city-star {
    font-size: 9px;
  }

  /* Mechanical Advancing Lever */
  .cc-viewmaster__lever-housing {
    position: relative;
    display: flex;
    align-items: center;
  }

  .cc-viewmaster-lever {
    position: relative;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    touch-action: manipulation;
    outline: none;
    transform-origin: top left;
  }

  .cc-viewmaster-lever:focus-visible .cc-lever-arm {
    box-shadow: 0 0 0 2px var(--navy-deep), 0 0 12px var(--yellow);
    border-color: var(--yellow);
  }

  .cc-lever-arm {
    width: 60px;
    height: 38px;
    background: linear-gradient(180deg, #c4182b 0%, #7d0b17 100%);
    border: 2px solid var(--yellow);
    border-radius: 4px 16px 16px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    transition: filter 0.15s ease;
  }

  .cc-viewmaster-lever:hover .cc-lever-arm {
    filter: brightness(1.15);
  }

  .cc-lever-ribs {
    width: 14px;
    height: 20px;
    background: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.3),
      rgba(255, 255, 255, 0.3) 2px,
      transparent 2px,
      transparent 5px
    );
  }

  .cc-lever-knob {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 6px var(--yellow);
  }

  .cc-lever-pulse-ring {
    position: absolute;
    inset: -4px;
    border: 2px solid var(--yellow);
    border-radius: 8px;
    pointer-events: none;
    opacity: 0;
  }

  .cc-lever-ghost-hand {
    top: -12px;
    right: -12px;
  }

  /* Viewport Stage */
  .cc-viewmaster__viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 480px;
    background: #000814;
    border: 3px solid var(--navy-deep);
    border-radius: 8px;
    box-shadow: inset 0 6px 20px rgba(0, 0, 0, 0.9);
    overflow: hidden;
    margin-bottom: 20px;
    touch-action: pan-y;
  }

  .cc-viewmaster__window-frame {
    width: 100%;
    height: 100%;
    display: flex;
