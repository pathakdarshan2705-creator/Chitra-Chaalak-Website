---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import * as aboutData from '../content/about/index.md';

const { frontmatter, Content } = aboutData;
---

<Layout title="About">
  <div class="about-layout">
    <main class="cc-col cc-col--center about-col">
      <Panel 
        title="ABOUT CHITRA CHAALAK" 
        showControls 
        group="about" 
        infoTitle="Profile Details" 
        infoMeta="Information about the creator, mission, and visual style."
      >
        <div class="about-content">
          <div class="about-header">
            <h1 class="glitch-title">{frontmatter.title}</h1>
            <p class="subtitle">{frontmatter.subtitle}</p>
          </div>

          <div class="text-block">
            <Content />
          </div>

          <div class="about-footer">
            <a href="/home" class="cc-btn return-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>RETURN TO SYSTEM</span>
            </a>
          </div>
        </div>
      </Panel>
    </main>
  </div>
</Layout>

<style>
  .about-layout {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .about-col {
    width: 100%;
    max-width: 800px;
    height: 80vh; /* Adjust height as needed to fit the screen */
    display: flex;
    flex-direction: column;
  }

  /* Make the Panel itself fill the column */
  .about-col > :global(.cc-panel) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .about-content {
    padding: 2rem;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
    color: var(--blue-lightest, #a6e8ff);
    font-family: var(--font-body, 'Rajdhani', sans-serif);
  }
  .about-content::-webkit-scrollbar { display: none; }

  .about-header {
    margin-bottom: 2rem;
    border-bottom: 1px dashed rgba(166, 232, 255, 0.2);
    padding-bottom: 1rem;
  }

  .glitch-title {
    font-family: var(--font-ui, 'IBM Plex Mono', monospace);
    color: var(--yellow, #fff000);
    font-size: 2rem;
    margin: 0 0 0.5rem 0;
    letter-spacing: 0.1em;
  }

  .subtitle {
    font-family: var(--font-ui, 'IBM Plex Mono', monospace);
    font-size: 0.85rem;
    color: var(--blue-panel-light, #67c8ff);
    letter-spacing: 0.2em;
    margin: 0;
  }

  .text-block {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  .text-block p {
    margin-bottom: 1.5rem;
  }

  .about-footer {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(166, 232, 255, 0.1);
    display: flex;
  }

  .return-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    background: rgba(0, 20, 50, 0.5);
    border: 1px solid rgba(166, 232, 255, 0.3);
    color: var(--blue-lightest, #a6e8ff);
    font-family: var(--font-ui, 'IBM Plex Mono', monospace);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .return-btn:hover {
    background: rgba(166, 232, 255, 0.15);
    border-color: rgba(166, 232, 255, 0.6);
    color: #fff;
    transform: translateX(-4px);
  }
</style>
