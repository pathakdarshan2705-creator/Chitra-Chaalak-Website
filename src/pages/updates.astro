---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import SidebarNav from '../components/SidebarNav.astro';
import UpdateTimeline from '../components/UpdateTimeline.astro';
import HolographicCanvas from '../components/HolographicCanvas.astro';
---

<Layout title="Updates — Daily Log">
  <div class="cc-inner-layout">
    <div class="cc-inner-layout__sidebar">
      <SidebarNav
        activePage="updates"
        pageTitle="In the Meantime"
        pageDescription="There is always something happening in the meantime.<br><br>Between projects, there are journeys. Between journeys, there are conversations, films, photographs, unfinished ideas, long walks, new places, and ordinary days that somehow become memorable. This is a small record of all of that.<br><br>I’ll leave things here as they happen, what I’m working on, where I’m going, what I’ve been seeing, what has been occupying my time, or simply what felt worth mentioning that day.<br><br>Nothing here is meant to be a finished thought. Just a way of keeping track of where I was, what I was doing, and what life looked like along the way."
        controlGroup="updates-archive"
        infoTitle="In the Meantime"
        infoMeta="A little record of what’s happening in the meantime."
      />
    </div>

    <div class="cc-inner-content">
      <Panel title="Updates Timeline" showControls={false}>
        <UpdateTimeline />
      </Panel>
    </div>
  </div>
  
  <HolographicCanvas />
</Layout>
