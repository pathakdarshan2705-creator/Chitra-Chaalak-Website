---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import Card from '../components/Card.astro';
import CassetteCard from '../components/CassetteCard.astro';
import ContactCard from '../components/ContactCard.astro';
import TransmissionCard from '../components/TransmissionCard.astro';
import { getCollection } from 'astro:content';

// Blog comes from src/content/blog/*.md — drop a new .md file there
// and it shows up here automatically, newest first, capped at 15.
const allBlogPosts = await getCollection('blog');
const blogPosts = allBlogPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 15)
  .map((post) => ({
    title: post.data.title,
    meta: `${post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()} · ${post.data.topic}`,
    imageSrc: post.data.image,
    href: `/blog/${post.id}`,
  }));

// Updates, films, tour, and collections stay hardcoded placeholders —
// same content-collection treatment applies to each when you're ready.

const updates = [
  'Travelling to Kutch',
  'Football match today',
  'New stone from Hampi',
];

const films = [
  { title: 'Pyaasa (1957)', meta: 'RECOMMENDATION', imageSrc: '/images/placeholder.jpg', href: '#' },
  { title: 'Andhadhun (2018)', meta: 'RECOMMENDATION', imageSrc: '/images/placeholder.jpg', href: '#' },
  { title: 'Charulata (1964)', meta: 'RECOMMENDATION', imageSrc: '/images/placeholder.jpg', href: '#' },
];

const visualTour = [
  { title: 'Mumbai', meta: 'VISUAL TOUR', imageSrc: '/images/placeholder.jpg', href: '#' },
];

const collections = [
  { title: 'Camera Collection', meta: 'COLLECTIONS', imageSrc: '/images/placeholder.jpg', href: '#' },
];

const portfolioSections = [
  { label: 'Filmmaking', href: '/portfolio/filmmaking' },
  { label: 'Photography', href: '/portfolio/photography' },
  { label: 'Design', href: '/portfolio/design' },
  { label: 'Art', href: '/portfolio/art' },
];
---
<Layout title="Home">
  <div class="cc-home">

    <!-- LEFT COLUMN: updates -->
    <aside class="cc-col cc-col--updates">
      <TransmissionCard
        title="Daily Transmission"
        date={new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()}
        items={updates}
      />
    </aside>

    <!-- CENTER COLUMN: films, blog, tour + collections -->
    <main class="cc-col cc-col--center">

      <div class="cc-row-fixed">
        <Panel title="Film Recommendations" viewAllHref="/films" showControls group="films">
          <div class="cc-card-row" id="films-list">
            {films.map((f) => (
              <Card title={f.title} meta={f.meta} imageSrc={f.imageSrc} href={f.href} group="films" />
            ))}
          </div>
        </Panel>
      </div>

      <div class="cc-row-flex">
        <Panel title="Blog" viewAllHref="/blog" showControls group="blog">
          <div class="cc-card-list" id="blog-list">
            {blogPosts.map((b) => (
              <Card title={b.title} meta={b.meta} imageSrc={b.imageSrc} href={b.href} group="blog" />
            ))}
          </div>
        </Panel>
      </div>

      <div class="cc-row-fixed cc-split-row">
        <Panel title="Visual Tour" viewAllHref="/tour">
          {visualTour.map((v) => (
            <Card title={v.title} meta={v.meta} imageSrc={v.imageSrc} href={v.href} group="tour" />
          ))}
        </Panel>

        <Panel title="Collections" viewAllHref="/collections">
          {collections.map((c) => (
            <Card title={c.title} meta={c.meta} imageSrc={c.imageSrc} href={c.href} group="collections" />
          ))}
        </Panel>
      </div>

    </main>

    <!-- RIGHT COLUMN: portfolio cassettes + contact -->
    <aside class="cc-col cc-col--portfolio">
      <Panel title="Portfolio" viewAllHref="/portfolio">
        <div class="cc-cassette-stack">
          {portfolioSections.map((p) => (
            <CassetteCard label={p.label} href={p.href} />
          ))}
        </div>
      </Panel>
      <ContactCard />
    </aside>

  </div>
</Layout>

<style>
  /* Fluid grid: column widths use fr (ratio measured from the 1920x1080
     reference: 396 : 1012 : 380), gaps stay fixed px (standard practice
     — gutters don't scale with viewport, content does). minmax() floors
     keep columns from collapsing below a usable width on narrower
     desktop screens. */
  .cc-home{
    height:100%;
    display:grid;
    grid-template-columns:
      minmax(280px, 396fr)
      var(--col-gap-left)
      minmax(560px, 1012fr)
      var(--col-gap-right)
      minmax(260px, 380fr);
    overflow:hidden;
  }

  .cc-col{
    min-width:0;
    height:100%;
    display:flex;
    flex-direction:column;
    gap:16px;
    overflow:hidden;
  }

  .cc-col--updates{ grid-column:1; }
  .cc-col--center{ grid-column:3; }
  .cc-col--portfolio{ grid-column:5; overflow-y:auto; scrollbar-width:none; }
  .cc-col--portfolio::-webkit-scrollbar{ display:none; }
  /* grid-columns 2 and 4 are the measured gaps — intentionally empty */

  .cc-row-fixed{ flex-shrink:0; }

  .cc-row-flex{
    flex:1 1 auto;
    min-height:0;
    display:flex;
  }

  .cc-row-flex > :global(.cc-panel){
    flex:1;
  }

  .cc-card-row{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:10px;
  }

  .cc-card-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    flex:1 1 auto;
    min-height:0;
    overflow-y:auto;
    scrollbar-width:none;
  }

  .cc-card-list::-webkit-scrollbar{ display:none; }

  .cc-split-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
  }

  .cc-cassette-stack{
    display:flex;
    flex-direction:column;
    gap:8px;
  }
</style>