---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import Card from '../components/Card.astro';
import CassetteCard from '../components/CassetteCard.astro';
import ContactCard from '../components/ContactCard.astro';
import BlogPreviewPane from '../components/BlogPreviewPane.astro';
import UpdateEntryCard from '../components/UpdateEntryCard.astro';
import SlideshowCard from '../components/SlideshowCard.astro';
import { getCollection } from 'astro:content';

const allBlogPosts = await getCollection('blog');
const blogPosts = allBlogPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 15)
  .map(post => ({
    title: post.data.title,
    meta: `${post.data.date.toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}).toUpperCase()} · ${post.data.topic}`,
    imageSrc: post.data.image,
    href: `/blog/${post.id}`,
  }));

const allUpdatesCol = await getCollection('updates');
const sortedUpdates = allUpdatesCol.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by date to match the existing UI of "one card per day with multiple items"
const groupedUpdates = sortedUpdates.reduce((acc, curr) => {
  const dateStr = curr.data.date.toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}).toUpperCase();
  if (!acc[dateStr]) {
    acc[dateStr] = [];
  }
  acc[dateStr].push(curr.data.title);
  return acc;
}, {} as Record<string, string[]>);

const updates = Object.entries(groupedUpdates).slice(0, 10).map(([date, items], index) => ({
  date,
  items,
  href: '/updates',
  isLatest: index === 0
}));

const films = [
  { title: 'Pyaasa (1957)', meta: 'DRAMA · GURU DUTT', imageSrc: '/images/placeholder.jpg', href: '/films/pyaasa' },
  { title: 'Andhadhun (2018)', meta: 'THRILLER · SRIRAM', imageSrc: '/images/placeholder.jpg', href: '/films/andhadhun' },
  { title: 'Charulata (1964)', meta: 'DRAMA · RAY', imageSrc: '/images/placeholder.jpg', href: '/films/charulata' },
  { title: 'Sholay (1975)', meta: 'ACTION · SIPPY', imageSrc: '/images/placeholder.jpg', href: '/films/sholay' },
  { title: 'Mughal-E-Azam (1960)', meta: 'DRAMA · ASIF', imageSrc: '/images/placeholder.jpg', href: '/films/mughal-e-azam' },
];

const visualTour = [
  { title: 'Mumbai', meta: 'VISUAL TOUR', imageSrc: '/images/placeholder.jpg', href: '/tour/mumbai' },
  { title: 'Kutch', meta: 'VISUAL TOUR', imageSrc: '/images/placeholder.jpg', href: '/tour/kutch' },
];

const collections = [
  { title: 'Camera Collection', meta: 'CAMERAS', imageSrc: '/images/placeholder.jpg', href: '/collections/cameras' },
  { title: 'Stone Collection', meta: 'STONES', imageSrc: '/images/placeholder.jpg', href: '/collections/stones' },
];

const portfolioSections = [
  { label: 'Filmmaking', href: '/portfolio/filmmaking' },
  { label: 'Photography', href: '/portfolio/photography' },
  { label: 'Design', href: '/portfolio/design' },
  { label: 'Art', href: '/portfolio/art' },
];
---
<Layout title="Home">
  <div class="cc-home">

    <nav class="cc-mobile-tabs" id="cc-mobile-tabs">
      <button class="cc-mobile-tab is-active" data-target="updates">CH 1 · UPDATES</button>
      <button class="cc-mobile-tab" data-target="center">CH 2 · WATCH</button>
      <button class="cc-mobile-tab" data-target="portfolio">CH 3 · WORK</button>
    </nav>

    <!-- LEFT: Updates -->
    <aside class="cc-col cc-col--updates" data-screen="updates">
      <Panel 
        title="Daily Transmission" 
        viewAllHref="/updates" 
        showControls 
        group="updates"
        infoTitle="Updates Section"
        infoMeta="A dynamic chronicle of daily thoughts, progress, and location-based logs."
      >
        <div class="cc-card-list" id="updates-list">
          {updates.map(u => (
            <UpdateEntryCard
              date={u.date}
              items={u.items}
              href={u.href}
              group="updates"
              isLatest={u.isLatest}
            />
          ))}
        </div>
      </Panel>
    </aside>

    <!-- CENTER: Film / Blog / Tour+Collections -->
    <main class="cc-col cc-col--center" data-screen="center">

      <div class="cc-row cc-row--film">
        <Panel title="Film Recommendations" viewAllHref="/films" showControls group="films" infoTitle="Film Section" infoMeta="A curated list of signal intercepts featuring must-watch films and documentaries.">
          <div class="cc-film-row">
            {films.map(f => (
              <Card title={f.title} meta={f.meta} imageSrc={f.imageSrc} href={f.href} group="films" variant="poster" />
            ))}
          </div>
        </Panel>
      </div>

      <div class="cc-row cc-row--blog">
        <Panel title="Blog" viewAllHref="/blog" showControls group="blog" infoTitle="Blog Database" infoMeta="In-depth thoughts, tutorials, and articles on design, code, and philosophy.">
          <div class="cc-blog-split">
            <div class="cc-card-list cc-blog-split__list" id="blog-list">
              {blogPosts.map(b => (
                <Card title={b.title} meta={b.meta} imageSrc={b.imageSrc} href={b.href} group="blog" variant="text" />
              ))}
            </div>
            <BlogPreviewPane group="blog" />
          </div>
        </Panel>
      </div>

      <div class="cc-row cc-row--bottom">
        <div class="cc-split-row">
          <Panel title="Visual Tour" viewAllHref="/tour" showControls group="tour" infoTitle="Visual Tour" infoMeta="A visual journey through the concepts and design language of this universe.">
            <SlideshowCard group="tour" items={visualTour} />
          </Panel>
          <Panel title="Collections" viewAllHref="/collections" showControls group="collections" infoTitle="My Collections" infoMeta="A curated inventory of personal items, resources, and inspirations.">
            <SlideshowCard group="collections" items={collections} />
          </Panel>
        </div>
      </div>

    </main>

    <!-- RIGHT: Portfolio + Contact -->
    <aside class="cc-col cc-col--portfolio" data-screen="portfolio">
      <Panel title="Portfolio" viewAllHref="/portfolio" showControls group="portfolio" infoTitle="Portfolio Archive" infoMeta="A structured repository of past projects, creations, and design work.">
        <div class="cc-cassette-stack">
          {portfolioSections.map(p => (
            <CassetteCard label={p.label} href={p.href} group="portfolio" />
          ))}
        </div>
      </Panel>
      <ContactCard />
    </aside>

    <div class="cc-mobile-dots" id="cc-mobile-dots">
      <span class="cc-mobile-dot is-active"></span>
      <span class="cc-mobile-dot"></span>
      <span class="cc-mobile-dot"></span>
    </div>

  </div>
</Layout>

<style>
  .cc-home {
    height: 100%;
    display: grid;
    grid-template-columns:
      minmax(240px, 396fr)
      var(--col-gap-left)
      minmax(500px, 1012fr)
      var(--col-gap-right)
      minmax(220px, 380fr);
    overflow: hidden;
  }

  .cc-col {
    min-width: 0; height: 100%;
    display: flex; flex-direction: column;
    gap: 0; overflow: hidden;
  }

  /* Updates column — the Panel itself is the single full-height child */
  .cc-col--updates { grid-column: 1; }
  .cc-col--updates > :global(.cc-panel) { flex: 1; }

  /* Center column — fixed proportions so Blog is always biggest */
  .cc-col--center { grid-column: 3; gap: 0; }
  .cc-row { display: flex; min-height: 0; }
  .cc-row > :global(.cc-panel) { flex: 1; }
  .cc-row--film  { flex: 0 0 33%; }
  .cc-row--blog  { flex: 1 1 auto; }
  .cc-row--bottom { flex: 0 0 22%; }

  /* Portfolio column */
  .cc-col--portfolio {
    grid-column: 5;
    gap: 10px;
    overflow: hidden;
  }
  .cc-col--portfolio > :global(.cc-panel) { flex-shrink: 1; min-height: 0; }
  .cc-col--portfolio > :global(.cc-contact-panel) { flex-shrink: 0; }

  /* Film row: poster cards side by side, taking full row height */
  .cc-film-row {
    display: flex;
    gap: 12px;
    height: 100%;
    align-items: stretch;
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cc-film-row::-webkit-scrollbar { display: none; }
  .cc-film-row > :global(.cc-card--poster) {
    height: 100%;
  }

  /* Blog split */
  .cc-blog-split {
    display: flex; gap: 10px;
    flex: 1; min-height: 0;
  }
  .cc-blog-split__list {
    flex: 0 0 40%; gap: 2px;
    overflow-y: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .cc-blog-split__list::-webkit-scrollbar { display: none; }

  /* Bottom split row */
  .cc-split-row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 14px; width: 100%; height: 100%;
  }
  .cc-split-row > :global(.cc-panel) { min-height: 0; }

  /* Card list — used in Updates and Blog */
  .cc-card-list {
    display: flex; flex-direction: column; gap: 8px;
    flex: 1; min-height: 0;
    overflow-y: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .cc-card-list::-webkit-scrollbar { display: none; }

  /* Cassette stack — tight gap so all 4 fit; scrolls internally if
     content ever exceeds available height, rather than the page/column */
  .cc-cassette-stack {
    display: flex; flex-direction: column; gap: 6px;
    min-height: 0;
    overflow-y: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .cc-cassette-stack::-webkit-scrollbar { display: none; }
</style>

<!-- Live status polling for the Updates LIVE badge -->
<script>
  // Polls the Cloudflare Worker endpoint every 30s.
  // Replace WORKER_URL with your deployed worker URL in Phase 4.
  const WORKER_URL = 'https://chitra-chaalak-status.pathakdarshan2705.workers.dev/status';
  const POLL_INTERVAL = 30000;

  async function checkLiveStatus() {
    const badge = document.getElementById('cc-live-badge');
    if (!badge) return;
    try {
      const res = await fetch(WORKER_URL, { cache: 'no-store' });
      if (!res.ok) throw new Error();
      const { online } = await res.json();
      if (online) {
        badge.textContent = 'LIVE';
        badge.classList.remove('is-offline');
      } else {
        badge.textContent = 'SOON';
        badge.classList.add('is-offline');
      }
    } catch (e) {
      // If fetch fails (CORS, offline, worker down), default to SOON
      console.error("Live status check failed:", e);
      badge.textContent = 'SOON';
      badge.classList.add('is-offline');
    }
  }
  checkLiveStatus();
  setInterval(checkLiveStatus, POLL_INTERVAL);
</script>

<script>
  if (!(window as any).__ccMobileTabsInit) {
    (window as any).__ccMobileTabsInit = true;

    const SCREENS = ['updates', 'center', 'portfolio'];
    const tabs = document.querySelectorAll<HTMLElement>('.cc-mobile-tab');
    const dots = document.querySelectorAll<HTMLElement>('.cc-mobile-dot');
    const cols = document.querySelectorAll<HTMLElement>('.cc-col');
    let current = 0;

    function showScreen(index: number) {
      current = index;
      cols.forEach(col => {
        col.classList.toggle('is-active-mobile', col.dataset.screen === SCREENS[index]);
      });
      tabs.forEach((tab, i) => tab.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => showScreen(i)));

    let touchStartX = 0;
    const home = document.querySelector('.cc-home');
    home?.addEventListener('touchstart', (e) => {
      touchStartX = (e as TouchEvent).touches[0].clientX;
    });
    home?.addEventListener('touchend', (e) => {
      const dx = (e as TouchEvent).changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) < 50) return;
      if (dx < 0 && current < SCREENS.length - 1) showScreen(current + 1);
      if (dx > 0 && current > 0) showScreen(current - 1);
    });

    showScreen(0);
  }
</script>