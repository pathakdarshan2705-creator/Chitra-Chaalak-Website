---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Welcome">
  <div class="hero-container">
    
    <!-- Ambient glow behind the subject -->
    <div class="ambient-glow"></div>

    <!-- Interesting layout elements: Floating targeting crosses -->
    <div class="crosshair crosshair-tl"></div>
    <div class="crosshair crosshair-tr"></div>
    <div class="crosshair crosshair-bl"></div>
    <div class="crosshair crosshair-br"></div>

    <div class="video-wrapper">
      <img 
        src="/images/hero.gif" 
        class="hero-video" 
        alt="Hero Animation"
      />
      <div class="video-vignette"></div>
    </div>

    <!-- Decorative Interface Lines -->
    <div class="hud-line hud-line-top"></div>
    <div class="hud-line hud-line-bottom"></div>
    <div class="hud-line hud-line-left"></div>
    <div class="hud-line hud-line-right"></div>

    <!-- Buttons -->
    <a href="/about" class="hero-btn btn-top-right">
      <span>ABOUT</span>
      <div class="btn-border"></div>
    </a>
    
    <a href="/home" class="hero-btn btn-bottom-right pulse-btn">
      <span class="next-text">ENTER</span>
      <div class="arrow-box">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter">
          <line x1="2" y1="12" x2="20" y2="12"></line>
          <polyline points="14 5 21 12 14 19"></polyline>
        </svg>
      </div>
      <div class="btn-border"></div>
    </a>

  </div>

  <script>
    // Listen for the 'Enter' key to navigate to the next page
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        window.location.href = '/home';
      }
    });
  </script>
</Layout>

<style is:global>
  /* Completely hide the footer and its spacer on the hero page to prevent it from popping up during load/refresh */
  .cc-footer, .cc-app__footer-spacer {
    display: none !important;
  }
</style>

<style>
  .hero-container {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: var(--navy-deep, #003b99);
    z-index: 500;
  }

  .ambient-glow {
    position: absolute;
    width: 60vw;
    height: 60vw;
    background: radial-gradient(circle, rgba(166, 232, 255, 0.15) 0%, rgba(0, 59, 153, 0) 65%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 501;
    /* Removed breathing animation to heavily reduce GPU repaint load */
  }

  /* --- New Interesting Elements: Crosshairs --- */
  .crosshair {
    position: absolute;
    width: 30px;
    height: 30px;
    z-index: 503;
    opacity: 0.3;
    will-change: opacity;
    animation: fadeIn 2s 1s forwards;
  }
  .crosshair::before, .crosshair::after {
    content: ''; position: absolute; background: var(--blue-lightest, #a6e8ff);
  }
  .crosshair::before { top: 14px; left: 0; right: 0; height: 1px; }
  .crosshair::after { left: 14px; top: 0; bottom: 0; width: 1px; }

  .crosshair-tl { top: 20%; left: 20%; }
  .crosshair-tr { top: 20%; right: 20%; }
  .crosshair-bl { bottom: 20%; left: 20%; }
  .crosshair-br { bottom: 20%; right: 20%; }

  .video-wrapper {
    position: relative;
    width: 65vw; 
    height: 65vh;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 502;
    will-change: transform, opacity;
    animation: slideUpFade 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-video {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    /* Removed expensive CSS mix-blend-mode and filter to dramatically reduce GPU load */
    opacity: 0.85; 
    will-change: transform;
  }

  .video-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Switched from expensive box-shadow to linear-gradients for performance */
    background: radial-gradient(circle, transparent 40%, var(--navy-deep, #003b99) 100%);
    border-radius: 12px;
  }

  /* --- HUD Lines --- */
  .hud-line {
    position: absolute;
    background: rgba(166, 232, 255, 0.1);
    z-index: 501;
  }
  .hud-line-top { top: 6rem; left: 0; right: 0; height: 1px; }
  .hud-line-bottom { bottom: 6rem; left: 0; right: 0; height: 1px; }
  .hud-line-left { top: 0; bottom: 0; left: 6rem; width: 1px; }
  .hud-line-right { top: 0; bottom: 0; right: 6rem; width: 1px; }

  /* --- Buttons --- */
  .hero-btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    color: var(--blue-lightest, #a6e8ff);
    text-decoration: none;
    font-family: var(--font-ui, 'IBM Plex Mono', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    background: rgba(0, 20, 50, 0.4);
    backdrop-filter: blur(12px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 510;
    overflow: hidden;
  }

  .btn-border {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(166, 232, 255, 0.15);
    transition: border-color 0.4s ease;
  }

  .hero-btn:hover {
    background: rgba(0, 84, 204, 0.2);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
  .hero-btn:hover .btn-border {
    border-color: rgba(166, 232, 255, 0.6);
  }

  .arrow-box {
    margin-left: 1rem;
    display: flex;
    align-items: center;
    transition: transform 0.4s ease;
  }
  .hero-btn:hover .arrow-box {
    transform: translateX(6px);
  }

  .btn-top-right {
    top: 2.5rem;
    right: 2.5rem;
  }

  .btn-bottom-right {
    bottom: 2.5rem;
    right: 2.5rem;
  }

  .pulse-btn::after {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--blue-panel-light, #67c8ff);
    opacity: 0;
    animation: ping 3s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  /* --- Animations --- */
  @keyframes slideUpFade {
    from { opacity: 0; transform: translateY(40px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 0.3; }
  }

  @keyframes breathe {
    0% { transform: scale(0.9); opacity: 0.8; }
    100% { transform: scale(1.1); opacity: 1; }
  }

  @keyframes ping {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(1.15); opacity: 0; }
  }

  @media (max-width: 768px) {
    .video-wrapper { width: 90vw; height: 50vh; }
    .btn-top-right { top: 1.5rem; right: 1.5rem; padding: 0.6rem 1rem; }
    .btn-bottom-right { bottom: 1.5rem; right: 1.5rem; padding: 0.6rem 1rem; }
    .hud-line, .crosshair { display: none; }
  }
</style>