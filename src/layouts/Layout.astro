---
// src/layouts/Layout.astro
import '../styles/global.css';
import FooterBanner from '../components/FooterBanner.astro';
import TestCardIntro from '../components/TestCardIntro.astro';
import RemoteControl from '../components/RemoteControl.astro';
import FocusFrame from '../components/FocusFrame.astro';
import TiltCards from '../components/TiltCards.astro';
import ChannelWipe from '../components/ChannelWipe.astro';
import CardInteractions from '../components/CardInteractions.astro';
import SoundEffects from '../components/SoundEffects.astro';
import CursorReticle from '../components/CursorReticle.astro';
import IdleScreenRoll from '../components/IdleScreenRoll.astro';
import CardPreviewDwell from '../components/CardPreviewDwell.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Chitra-Chaalak</title>
</head>
<body>
  <SoundEffects />
  <TestCardIntro />
  <CardInteractions />
  <RemoteControl />
  <FocusFrame />
  <TiltCards />
  <ChannelWipe />
  <CursorReticle />
  <IdleScreenRoll />
  <CardPreviewDwell />
  <div class="cc-scanlines"></div>
  <div class="cc-vignette"></div>
  <div class="cc-flicker"></div>
  <div class="cc-crt-edge"></div>

  <div id="cc-preview-popover" class="cc-preview-popover" hidden>
    <div class="cc-preview-popover__frame">
      <img class="cc-preview-popover__img" src="" alt="" />
      <div class="cc-preview-popover__title"></div>
      <div class="cc-preview-popover__meta"></div>
    </div>
  </div>

  <div class="cc-app">
    <div class="cc-app__content">
      <slot />
    </div>
    <div class="cc-app__footer-spacer"></div>
    <FooterBanner />
  </div>

  <script>
    // @ts-nocheck
    import { gsap } from 'gsap';
    
    // Global Entrance Animation for page load
    gsap.from('.cc-app__content', {
      opacity: 0,
      y: 15,
      duration: 0.8,
      ease: "power2.out",
      clearProps: "all"
    });
  </script>
</body>
</html>